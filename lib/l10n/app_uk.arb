  "relapseMessage14": "Зцілення не відбувається миттєво, але воно відбувається з кожним вашим вибором.",
  "@relapseMessage14": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage15": "Ви не починаєте спочатку — ви продовжуєте з більшою мудрістю.",
  "@relapseMessage15": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage16": "Кожен експерт колись був початківцем. Кожен професіонал колись був любителем.",
  "@relapseMessage16": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage17": "Відновлення відбувається через день, іноді через годину.",
  "@relapseMessage17": {
    "description": "Encouragement message for relapse"
