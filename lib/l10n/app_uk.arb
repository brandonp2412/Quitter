  "@smokingMilestone30Title": {
    "description": "Smoking milestone day 30 title"
  },
  "smokingMilestone30Description": "Ваші легені влаштовують вечірку для повернення! Вії знову відросли і вимітають роки смол і сміття. Ємність легенів значно збільшується, і цей кашель курця залишився в історії.",
  "@smokingMilestone30Description": {
    "description": "Smoking milestone day 30 description"
  },
  "smokingMilestone90Title": "Ризик серцевого нападу значно знижується",
