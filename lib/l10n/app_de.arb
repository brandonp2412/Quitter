  "cocainePageTitle": "Kokaingewinnung",
  "@cocainePageTitle": {"description": "Title of the cocaine recovery page."},
  "cocaineHeaderStarted": "Ihre Recovery Journey",
  "@cocaineHeaderStarted": {"description": "Heading shown after cocaine tracking starts."},
  "cocaineHeaderNotStarted": "Bereit zum Start?",
  "@cocaineHeaderNotStarted": {"description": "Heading shown before cocaine tracking starts."},
  "cocaineSubtitleStarted": "Verfolgen Sie Ihre Fortschritte und feiern Sie jeden Meilenstein",
  "@cocaineSubtitleStarted": {"description": "Subtitle shown after cocaine tracking starts."},
  "cocaineSubtitleNotStarted": "Sehen Sie, welche positiven Veränderungen Sie erwarten",
  "@cocaineSubtitleNotStarted": {"description": "Subtitle shown before cocaine tracking starts."},
  "cocaineMilestone1Title": "Erste 24 Stunden: Der Anfang",
  "@cocaineMilestone1Title": {"description": "Title for the cocaine recovery milestone at 1 day."},
  "cocaineMilestone1Description": "Ihr Körper beginnt sich anzupassen, während sich der Dopaminhaushalt stabilisiert. Müdigkeit, Stimmungsschwankungen und starkes Verlangen nach Kokain können auftreten, doch Ihr Herz-Kreislauf-System beginnt sich bereits zu erholen.",
  "@cocaineMilestone1Description": {"description": "Description for the cocaine recovery milestone at 1 day."},
  "cocaineMilestone3Title": "Tag 3: Die schwierigste Phase",
  "@cocaineMilestone3Title": {"description": "Title for the cocaine recovery milestone at 3 days."},
  "cocaineMilestone3Description": "Entzugssymptome erreichen um diese Zeit häufig ihren Höhepunkt. Starkes Verlangen, Reizbarkeit, Angst und Erschöpfung können auftreten. Das ist vorübergehend: Ihr Gehirn arbeitet daran, sein Gleichgewicht wiederzufinden.",
  "@cocaineMilestone3Description": {"description": "Description for the cocaine recovery milestone at 3 days."},
  "cocaineMilestone7Title": "Eine Woche: Körperliche Erholung",
  "@cocaineMilestone7Title": {"description": "Title for the cocaine recovery milestone at 7 days."},
  "cocaineMilestone7Description": "Die stärksten körperlichen Symptome beginnen nachzulassen. Herzfrequenz und Blutdruck stabilisieren sich. Psychisches Verlangen kann weiterhin auftreten, während sich Ihr Körper erholt.",
  "@cocaineMilestone7Description": {"description": "Description for the cocaine recovery milestone at 7 days."},
  "cocaineMilestone14Title": "Zwei Wochen: Mehr Stabilität",
  "@cocaineMilestone14Title": {"description": "Title for the cocaine recovery milestone at 14 days."},
  "cocaineMilestone14Description": "Viele Menschen fühlen sich emotional allmählich stabiler. Die Energie nimmt zu und akute Entzugssymptome lassen nach. Auch die Herz-Kreislauf-Gesundheit verbessert sich weiter.",
  "@cocaineMilestone14Description": {"description": "Description for the cocaine recovery milestone at 14 days."},
  "cocaineMilestone60Title": "Zwei Monate: Schlaf und Stimmung",
  "@cocaineMilestone60Title": {"description": "Title for the cocaine recovery milestone at 60 days."},
  "cocaineMilestone60Description": "Ihre Schlafqualität ist spürbar besser, während sich die Gehirnchemie weiter normalisiert. Sie fühlen sich möglicherweise ausgeruhter und erleben über den Tag hinweg stabilere Stimmungen.",
  "@cocaineMilestone60Description": {"description": "Description for the cocaine recovery milestone at 60 days."},
  "cocaineMilestone90Title": "Drei Monate: Erholung des Gehirns",
  "@cocaineMilestone90Title": {"description": "Title for the cocaine recovery milestone at 90 days."},
  "cocaineMilestone90Description": "Ihr Dopaminsystem erholt sich. Konzentration, Entscheidungsfindung und Emotionsregulation sind deutlich besser, und das Denken wird klarer.",
  "@cocaineMilestone90Description": {"description": "Description for the cocaine recovery milestone at 90 days."},
  "cocaineMilestone180Title": "Sechs Monate: Klareres Denken",
  "@cocaineMilestone180Title": {"description": "Title for the cocaine recovery milestone at 180 days."},
  "cocaineMilestone180Description": "Bildgebungsstudien zeigen Erholung im vorderen Bereich des Gehirns, der Planung und Selbstkontrolle unterstützt. Gedächtnis, Impulskontrolle und klares Denken stärken sich weiter.",
  "@cocaineMilestone180Description": {"description": "Description for the cocaine recovery milestone at 180 days."},
  "cocaineMilestone365Title": "Ein Jahr: Herz-Kreislauf-Gesundheit",
  "@cocaineMilestone365Title": {"description": "Title for the cocaine recovery milestone at 365 days."},
  "cocaineMilestone365Description": "Ihr Herz und Ihr Herz-Kreislauf-System haben sich deutlich erholt. Blutdruck und Herzfrequenz haben sich normalisiert. Das Risiko für Herzinfarkt und Schlaganfall ist erheblich gesunken. Ihr Körper erholt sich weiter.",
  "@cocaineMilestone365Description": {"description": "Description for the cocaine recovery milestone at 365 days."},
  "cocaineMilestone730Title": "Zwei Jahre: Anhaltende Genesung",
  "@cocaineMilestone730Title": {"description": "Title for the cocaine recovery milestone at 730 days."},
  "cocaineMilestone730Description": "Die Erholung des Gehirns setzt sich fort, begleitet von anhaltenden Verbesserungen bei Gedächtnis, Konzentration und Emotionsregulation. Die neuronalen Bahnen haben sich deutlich neu organisiert und unterstützen gesündere Verhaltensmuster und ein besseres allgemeines Wohlbefinden.",
  "@cocaineMilestone730Description": {"description": "Description for the cocaine recovery milestone at 730 days."},
  "cocaineMilestone1095Title": "Drei Jahre: Starkes Fundament",
  "@cocaineMilestone1095Title": {"description": "Title for the cocaine recovery milestone at 1095 days."},
  "cocaineMilestone1095Description": "Drei Jahre ohne Kokain sind nachhaltiger Fortschritt. Routinen, Beziehungen und Bewältigungsstrategien konnten sich über Jahre festigen und geben deiner Genesung ein starkes Fundament.",
  "@cocaineMilestone1095Description": {"description": "Description for the cocaine recovery milestone at 1095 days."},
  "cocaineMilestone1460Title": "Vier Jahre: Dauerhafter Schwung",
  "@cocaineMilestone1460Title": {"description": "Title for the cocaine recovery milestone at 1460 days."},
  "cocaineMilestone1460Description": "Vier Jahre zeigen dauerhaften Schwung. Ein weiteres Jahr ohne Kokain hat die Gewohnheiten und die Unterstützung gestärkt, die deine Genesung stabil halten.",
  "@cocaineMilestone1460Description": {"description": "Description for the cocaine recovery milestone at 1460 days."},
  "cocaineMilestone1825Title": "Fünf Jahre: Dauerhaft gefestigt",
  "@cocaineMilestone1825Title": {"description": "Title for the cocaine recovery milestone at 1825 days."},
  "cocaineMilestone1825Description": "Fünf Jahre sind ein großer Jahrestag. Ein halbes Jahrzehnt Beständigkeit hat ein Leben gefestigt, das stärker von deinen Werten, Beziehungen und Zielen als von Kokain bestimmt wird.",
  "@cocaineMilestone1825Description": {"description": "Description for the cocaine recovery milestone at 1825 days."},
