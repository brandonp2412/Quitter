  "kratomSubtitleNotStarted": "Sehen Sie, was passiert, wenn Sie aufhören",
  "@kratomSubtitleNotStarted": {"description": "Subtitle shown before kratom tracking starts."},
  "kratomInfoBox": "Kratom wirkt auf Opioidrezeptoren, so dass das Stoppen einen opioidähnlichen Entzug erzeugen kann. Wenn Sie stark oder neben anderen Opioiden verwenden, fragen Sie einen Arzt über medizinisch überwachten Entzug.",
  "@kratomInfoBox": {"description": "Recovery information shown on the kratom page."},
  "addictionKratom": "Kratom",
  "@addictionKratom": {"description": "Name of the kratom addiction category."},
  "kratomMilestone1Title": "Der Entzug beginnt",
  "@kratomMilestone1Title": {"description": "Title for the kratom recovery milestone at 1 day."},
  "kratomMilestone1Description": "Kratom wirkt auf Opioidrezeptoren. Innerhalb von 6–12 Stunden nach der letzten Dosis können deshalb Unruhe, Angst, Schwitzen, eine laufende Nase und Muskelschmerzen auftreten. Dein Nervensystem beginnt, sich anzupassen.",
  "@kratomMilestone1Description": {"description": "Description for the kratom recovery milestone at 1 day."},
  "kratomMilestone3Title": "Höhepunkt des Entzugs",
  "@kratomMilestone3Title": {"description": "Title for the kratom recovery milestone at 3 days."},
  "kratomMilestone3Description": "Akute Symptome erreichen meist um Tag 2–3 ihren Höhepunkt: stärkere Schmerzen, Schlaflosigkeit, Magen-Darm-Beschwerden und gedrückte Stimmung. Das ist die schwierigste Phase, aber sie ist vorübergehend.",
  "@kratomMilestone3Description": {"description": "Description for the kratom recovery milestone at 3 days."},
  "kratomMilestone7Title": "Akute Symptome lassen nach",
  "@kratomMilestone7Title": {"description": "Title for the kratom recovery milestone at 7 days."},
  "kratomMilestone7Description": "Nach einer Woche sind die schlimmsten körperlichen Symptome — Schmerzen, Magen-Darm-Beschwerden und Schwitzen — weitgehend abgeklungen. Schlaf und Energie erholen sich noch.",
  "@kratomMilestone7Description": {"description": "Description for the kratom recovery milestone at 7 days."},
  "kratomMilestone14Title": "Stimmung und Schlaf erholen sich",
  "@kratomMilestone14Title": {"description": "Title for the kratom recovery milestone at 14 days."},
  "kratomMilestone14Description": "Nach zwei Wochen wird der Schlaf verlässlicher und die Stimmung stabiler, während sich das körpereigene Belohnungssystem des Gehirns neu einpendelt.",
  "@kratomMilestone14Description": {"description": "Description for the kratom recovery milestone at 14 days."},
  "kratomMilestone30Title": "Ein Monat ohne Kratom",
  "@kratomMilestone30Title": {"description": "Title for the kratom recovery milestone at 30 days."},
  "kratomMilestone30Description": "Nach einem Monat hat sich der Körper deutlich stabilisiert: Schlaf, Appetit und Energie sind merklich besser, und starkes Verlangen tritt seltener auf.",
  "@kratomMilestone30Description": {"description": "Description for the kratom recovery milestone at 30 days."},
  "kratomMilestone90Title": "Stabile Grundlage",
  "@kratomMilestone90Title": {"description": "Title for the kratom recovery milestone at 90 days."},
  "kratomMilestone90Description": "Drei Monate ohne Kratom geben den Belohnungs- und Stresssystemen des Gehirns länger Zeit, sich neu zu regulieren. Stimmung, Konzentration und Motivation werden spürbar stabiler.",
  "@kratomMilestone90Description": {"description": "Description for the kratom recovery milestone at 90 days."},
  "kratomMilestone365Title": "Ein Jahr ohne Kratom",
  "@kratomMilestone365Title": {"description": "Title for the kratom recovery milestone at 365 days."},
  "kratomMilestone365Description": "Ein ganzes Jahr ohne Kratom. Das Opioidsystem hatte lange Zeit, sich neu zu regulieren, starkes Verlangen ist selten geworden, und die Gewohnheit bestimmt deinen Tagesablauf nicht mehr.",
  "@kratomMilestone365Description": {"description": "Description for the kratom recovery milestone at 365 days."},
  "kratomMilestone730Title": "Zwei Jahre: Fester Boden",
  "@kratomMilestone730Title": {"description": "Title for the kratom recovery milestone at 730 days."},
  "kratomMilestone730Description": "Zwei Jahre ohne Kratom sind eine lange Phase beständiger Veränderung. Die Routinen und Entscheidungen auf diesem Weg konnten Teil des Alltags werden.",
  "@kratomMilestone730Description": {"description": "Description for the kratom recovery milestone at 730 days."},
  "kratomMilestone1095Title": "Drei Jahre: Eigener Schwung",
  "@kratomMilestone1095Title": {"description": "Title for the kratom recovery milestone at 1095 days."},
  "kratomMilestone1095Description": "Drei Jahre bedeuten ein weiteres volles Jahr mit dem Leben jenseits von Kratom. Diese Beständigkeit ist über lange Zeit aufgebauter Schwung.",
  "@kratomMilestone1095Description": {"description": "Description for the kratom recovery milestone at 1095 days."},
  "kratomMilestone1460Title": "Vier Jahre: Stabile Freiheit",
  "@kratomMilestone1460Title": {"description": "Title for the kratom recovery milestone at 1460 days."},
  "kratomMilestone1460Description": "Vier Jahre sind anhaltende Freiheit, getragen von Tausenden alltäglichen Entscheidungen. Was früher ständig Kraft kostete, kann heute weiter in den Hintergrund treten.",
  "@kratomMilestone1460Description": {"description": "Description for the kratom recovery milestone at 1460 days."},
  "kratomMilestone1825Title": "Fünf Jahre: Dauerhaft stark",
  "@kratomMilestone1825Title": {"description": "Title for the kratom recovery milestone at 1825 days."},
  "kratomMilestone1825Description": "Fünf Jahre sind ein großes Jubiläum: 1.825 Tage in derselben Richtung. Das Leben, das um diese Entscheidung gewachsen ist, ist die eigentliche Leistung.",
  "@kratomMilestone1825Description": {"description": "Description for the kratom recovery milestone at 1825 days."},
  "gabapentinoidsPageTitle": "Gabapentinoide",
  "@gabapentinoidsPageTitle": {"description": "Title of the gabapentinoids recovery page."},
  "gabapentinoidsHeaderStarted": "Ihre Recovery Journey",
  "@gabapentinoidsHeaderStarted": {"description": "Heading shown after gabapentinoids tracking starts."},
  "gabapentinoidsHeaderNotStarted": "Vorteile der Beendigung Gabapentin / Pregabalin",
  "@gabapentinoidsHeaderNotStarted": {"description": "Heading shown before gabapentinoids tracking starts."},
  "gabapentinoidsSubtitleStarted": "Verfolgen Sie Ihre Fortschritte und feiern Sie jeden Meilenstein",
  "@gabapentinoidsSubtitleStarted": {"description": "Subtitle shown after gabapentinoids tracking starts."},
  "gabapentinoidsSubtitleNotStarted": "Sehen Sie, was passiert, wenn Sie aufhören",
  "@gabapentinoidsSubtitleNotStarted": {"description": "Subtitle shown before gabapentinoids tracking starts."},
  "gabapentinoidsInfoBox": "Niemals Gabapentin oder Pregabalin abrupt stoppen. Plötzliches Absetzen kann Anfälle auslösen - besonders wenn Sie sie wegen Epilepsie einnehmen. Eine allmähliche, medizinisch überwachte Verjüngung ist unerlässlich.",
  "@gabapentinoidsInfoBox": {"description": "Recovery information shown on the gabapentinoids page."},
  "addictionGabapentinoid": "Gabapentin/Pregabalin",
  "@addictionGabapentinoid": {"description": "Name of the gabapentinoid addiction category."},
  "ghbPageTitle": "GHB",
  "@ghbPageTitle": {"description": "Title of the ghb recovery page."},
  "ghbHeaderStarted": "Ihre Recovery Journey",
  "@ghbHeaderStarted": {"description": "Heading shown after ghb tracking starts."},
  "ghbHeaderNotStarted": "Vorteile der Beendigung von GHB",
  "@ghbHeaderNotStarted": {"description": "Heading shown before ghb tracking starts."},
  "ghbSubtitleStarted": "Verfolgen Sie Ihre Fortschritte und feiern Sie jeden Meilenstein",
  "@ghbSubtitleStarted": {"description": "Subtitle shown after ghb tracking starts."},
  "ghbSubtitleNotStarted": "Sehen Sie, was passiert, wenn Sie aufhören",
  "@ghbSubtitleNotStarted": {"description": "Subtitle shown before ghb tracking starts."},
  "ghbInfoBox": "GHB-Entzug ist ein medizinischer Notfall - er konkurriert mit Alkohol- und Benzodiazepinentzug und kann Delirium und Anfälle verursachen. Schwere oder rund um die Uhr Benutzer sollten nicht aufhören, ohne überwachte stationäre Entgiftung.",
  "@ghbInfoBox": {"description": "Recovery information shown on the ghb page."},
  "addictionGhb": "GHB",
  "@addictionGhb": {"description": "Name of the ghb addiction category."},
  "ghbMilestone1Title": "Medizinische Hilfe beim Entzug",
  "@ghbMilestone1Title": {"description": "Title for the ghb recovery milestone at 1 day."},
  "ghbMilestone1Description": "GHB hat eine sehr kurze Halbwertszeit, deshalb kann der Entzug schon 1–6 Stunden nach der letzten Dosis mit Angst, Zittern, Schlaflosigkeit und schnellem Puls beginnen. Er gehört zu den gefährlichsten Entzugssyndromen – holen Sie medizinische Hilfe.",
  "@ghbMilestone1Description": {"description": "Description for the ghb recovery milestone at 1 day."},
  "ghbMilestone3Title": "Höchste Gefahrenphase",
  "@ghbMilestone3Title": {"description": "Title for the ghb recovery milestone at 3 days."},
  "ghbMilestone3Description": "Die Symptome erreichen nach etwa 48–72 Stunden ihren Höhepunkt und können sich zu starker Unruhe, Halluzinationen und Delir entwickeln. Diese Phase muss medizinisch überwacht werden.",
  "@ghbMilestone3Description": {"description": "Description for the ghb recovery milestone at 3 days."},
  "ghbMilestone7Title": "Akutphase klingt ab",
  "@ghbMilestone7Title": {"description": "Title for the ghb recovery milestone at 7 days."},
  "ghbMilestone7Description": "Nach etwa einer Woche klingt das akute Syndrom meist ab, auch wenn ein Delir in schweren Fällen länger anhalten kann. Die gefährlichste Phase liegt hinter Ihnen.",
  "@ghbMilestone7Description": {"description": "Description for the ghb recovery milestone at 7 days."},
  "ghbMilestone14Title": "Das Schlimmste ist überstanden",
  "@ghbMilestone14Title": {"description": "Title for the ghb recovery milestone at 14 days."},
  "ghbMilestone14Description": "Nach zwei Wochen ist selbst ein schwerer Entzug meist weitgehend abgeklungen. Schlaf und vegetative Stabilität kehren zurück, auch wenn Angst noch anhalten kann.",
  "@ghbMilestone14Description": {"description": "Description for the ghb recovery milestone at 14 days."},
  "ghbMilestone30Title": "Ein Monat stabil",
  "@ghbMilestone30Title": {"description": "Title for the ghb recovery milestone at 30 days."},
  "ghbMilestone30Description": "Nach einem Monat liegt die gefährliche frühe Entzugsphase deutlich hinter Ihnen. Verbleibende Angst, Schlafprobleme und gedrückte Stimmung bessern sich weiter.",
  "@ghbMilestone30Description": {"description": "Description for the ghb recovery milestone at 30 days."},
  "ghbMilestone90Title": "Restbeschwerden klingen ab",
  "@ghbMilestone90Title": {"description": "Title for the ghb recovery milestone at 90 days."},
  "ghbMilestone90Description": "Nach drei Monaten lassen anhaltende Angst-, Schlaf- und Stimmungssymptome nach, während sich das beruhigende GABA-System des Gehirns weiter stabilisiert.",
  "@ghbMilestone90Description": {"description": "Description for the ghb recovery milestone at 90 days."},
  "ghbMilestone180Title": "Ein halbes Jahr ohne GHB",
  "@ghbMilestone180Title": {"description": "Title for the ghb recovery milestone at 180 days."},
  "ghbMilestone180Description": "Sechs Monate ohne GHB. Anhaltende Entzugssymptome sind weitgehend abgeklungen, und Stimmung, Schlaf und klares Denken haben sich normalisiert.",
  "@ghbMilestone180Description": {"description": "Description for the ghb recovery milestone at 180 days."},
  "ketaminePageTitle": "Ketamin",
  "@ketaminePageTitle": {"description": "Title of the ketamine recovery page."},
  "ketamineHeaderStarted": "Ihre Recovery Journey",
  "@ketamineHeaderStarted": {"description": "Heading shown after ketamine tracking starts."},
  "ketamineHeaderNotStarted": "Vorteile der Beendigung von Ketamin",
  "@ketamineHeaderNotStarted": {"description": "Heading shown before ketamine tracking starts."},
  "ketamineSubtitleStarted": "Verfolgen Sie Ihre Fortschritte und feiern Sie jeden Meilenstein",
  "@ketamineSubtitleStarted": {"description": "Subtitle shown after ketamine tracking starts."},
  "ketamineSubtitleNotStarted": "Sehen Sie, was passiert, wenn Sie aufhören",
  "@ketamineSubtitleNotStarted": {"description": "Subtitle shown before ketamine tracking starts."},
  "ketamineInfoBox": "Ketamin-Entzug ist vor allem Heißhunger, schlechte Stimmung und Gehirn Nebel eher als körperliche Krankheit. Sein größter körperlicher Schaden ist Blasenschaden, und das Anhalten ist der wesentliche erste Schritt zur Genesung.",
  "@ketamineInfoBox": {"description": "Recovery information shown on the ketamine page."},
  "addictionKetamine": "Ketamin",
  "@addictionKetamine": {"description": "Name of the ketamine addiction category."},
  "ketamineMilestone1Title": "Ketamin wird abgebaut",
  "@ketamineMilestone1Title": {"description": "Title for the ketamine recovery milestone at 1 day."},
  "ketamineMilestone1Description": "Ketamin verursacht nur selten einen schweren körperlichen Entzug. Am ersten Tag können beim Abbau des Wirkstoffs Stimmungsschwankungen, Verlangen, Schwitzen oder Herzklopfen auftreten.",
  "@ketamineMilestone1Description": {"description": "Description for the ketamine recovery milestone at 1 day."},
  "ketamineMilestone7Title": "Stimmung und Verlangen",
  "@ketamineMilestone7Title": {"description": "Title for the ketamine recovery milestone at 7 days."},
  "ketamineMilestone7Description": "In der ersten Woche stehen meist Verlangen, gedrückte oder wechselnde Stimmung und Konzentrationsnebel im Vordergrund, nicht der körperliche Entzug.",
  "@ketamineMilestone7Description": {"description": "Description for the ketamine recovery milestone at 7 days."},
  "ketamineMilestone14Title": "Der Gehirnnebel lichtet sich",
  "@ketamineMilestone14Title": {"description": "Title for the ketamine recovery milestone at 14 days."},
  "ketamineMilestone14Description": "Nach zwei Wochen beginnen sich Denken und Gedächtnis zu klären und die Stimmung zu stabilisieren, wenn die dissoziativen Effekte vollständig nachlassen.",
  "@ketamineMilestone14Description": {"description": "Description for the ketamine recovery milestone at 14 days."},
  "ketamineMilestone30Title": "Ein Monat — Erholung der Blase",
  "@ketamineMilestone30Title": {"description": "Title for the ketamine recovery milestone at 30 days."},
  "ketamineMilestone30Description": "Nach einem Monat bessern sich frühe Blasenschäden nach dem Aufhören häufig bereits. Stimmung und Denken sind klarer.",
  "@ketamineMilestone30Description": {"description": "Description for the ketamine recovery milestone at 30 days."},
  "ketamineMilestone90Title": "Drei Monate ohne Ketamin",
  "@ketamineMilestone90Title": {"description": "Title for the ketamine recovery milestone at 90 days."},
  "ketamineMilestone90Description": "Drei Monate ohne Ketamin geben der Blase mehr Zeit zur Erholung, während sich Denken und Stimmung weiter bessern. Das Verlangen tritt seltener auf.",
  "@ketamineMilestone90Description": {"description": "Description for the ketamine recovery milestone at 90 days."},
  "ketamineMilestone180Title": "Ein halbes Jahr ohne Ketamin",
  "@ketamineMilestone180Title": {"description": "Title for the ketamine recovery milestone at 180 days."},
  "ketamineMilestone180Description": "Sechs Monate ohne Ketamin. Die Blasensymptome hatten länger Zeit, sich zu bessern, und der psychische Drang nach Ketamin hat deutlich nachgelassen.",
  "@ketamineMilestone180Description": {"description": "Description for the ketamine recovery milestone at 180 days."},
  "ketamineMilestone365Title": "Ein Jahr ohne Ketamin",
  "@ketamineMilestone365Title": {"description": "Title for the ketamine recovery milestone at 365 days."},
  "ketamineMilestone365Description": "Ein Jahr ohne Ketamin. Denken und Stimmung sowie — bei früh erkanntem Blasenschaden — die Blasenfunktion hatten ein volles Jahr Zeit zur Erholung.",
  "@ketamineMilestone365Description": {"description": "Description for the ketamine recovery milestone at 365 days."},
  "ketamineMilestone730Title": "Zwei Jahre: Fester Boden",
  "@ketamineMilestone730Title": {"description": "Title for the ketamine recovery milestone at 730 days."},
  "ketamineMilestone730Description": "Zwei Jahre ohne Ketamin sind nachhaltiger Fortschritt. Weiterhin darauf zu verzichten verhindert erneute Exposition; die Erholung nach früherem Konsum bleibt individuell.",
  "@ketamineMilestone730Description": {"description": "Description for the ketamine recovery milestone at 730 days."},
  "ketamineMilestone1095Title": "Drei Jahre: Schwung gefestigt",
  "@ketamineMilestone1095Title": {"description": "Title for the ketamine recovery milestone at 1095 days."},
  "ketamineMilestone1095Description": "Drei Jahre stehen für beständigen Fortschritt. Forschung zeigt Verbesserungen nach dem Absetzen von Ketamin, aber keinen besonderen biologischen Endpunkt nach drei Jahren.",
  "@ketamineMilestone1095Description": {"description": "Description for the ketamine recovery milestone at 1095 days."},
  "ketamineMilestone1460Title": "Vier Jahre: Stetige Stärke",
  "@ketamineMilestone1460Title": {"description": "Title for the ketamine recovery milestone at 1460 days."},
  "ketamineMilestone1460Description": "Vier Jahre bedeuten ein weiteres Jahr Abstand zu Ketamin. Langfristige Erholung kann weitergehen; das Ergebnis hängt von früherem Konsum und vorhandenen Schäden ab.",
  "@ketamineMilestone1460Description": {"description": "Description for the ketamine recovery milestone at 1460 days."},
  "ketamineMilestone1825Title": "Fünf Jahre: Tiefe Wurzeln",
  "@ketamineMilestone1825Title": {"description": "Title for the ketamine recovery milestone at 1825 days."},
  "ketamineMilestone1825Description": "Fünf Jahre sind ein großer langfristiger Meilenstein. Bewährte Routinen und Unterstützung weiter zu pflegen stärkt das aufgebaute Fundament.",
  "@ketamineMilestone1825Description": {"description": "Description for the ketamine recovery milestone at 1825 days."},
  "inhalantsPageTitle": "Inhalantien",
  "@inhalantsPageTitle": {"description": "Title of the inhalants recovery page."},
  "inhalantsHeaderStarted": "Ihre Recovery Journey",
  "@inhalantsHeaderStarted": {"description": "Heading shown after inhalants tracking starts."},
  "inhalantsHeaderNotStarted": "Vorteile des Beendens von Inhalationsmitteln",
  "@inhalantsHeaderNotStarted": {"description": "Heading shown before inhalants tracking starts."},
  "inhalantsSubtitleStarted": "Verfolgen Sie Ihre Fortschritte und feiern Sie jeden Meilenstein",
  "@inhalantsSubtitleStarted": {"description": "Subtitle shown after inhalants tracking starts."},
  "inhalantsSubtitleNotStarted": "Sehen Sie, was passiert, wenn Sie aufhören",
  "@inhalantsSubtitleNotStarted": {"description": "Subtitle shown before inhalants tracking starts."},
  "inhalantsInfoBox": "Inhalationsentzug ist kürzer als Alkohol oder Opioide, kann aber intensiv sein, mit Anfallsrisiko bei schweren Benutzern. Neurologische Erholung ist real, aber langsam - oft entfaltet sich über etwa zwei Jahre Abstinenz.",
  "@inhalantsInfoBox": {"description": "Recovery information shown on the inhalants page."},
  "addictionInhalants": "Inhalationsmittel",
  "@addictionInhalants": {"description": "Name of the inhalants addiction category."},
  "inhalantsMilestone1Title": "Der Körper baut die Stoffe ab",
  "@inhalantsMilestone1Title": {"description": "Title for the inhalants recovery milestone at 1 day."},
  "inhalantsMilestone1Description": "Inhalierte Chemikalien verschwinden schnell aus dem Blut, können aber im Fettgewebe länger verbleiben. Am ersten Tag können Kopfschmerzen, Reizbarkeit, Übelkeit, Angst oder Schlaflosigkeit auftreten.",
  "@inhalantsMilestone1Description": {"description": "Description for the inhalants recovery milestone at 1 day."},
  "inhalantsMilestone7Title": "Akute Symptome lassen nach",
  "@inhalantsMilestone7Title": {"description": "Title for the inhalants recovery milestone at 7 days."},
  "inhalantsMilestone7Description": "Akute Entzugssymptome erreichen meist an den Tagen 2–5 ihren Höhepunkt und klingen innerhalb von ein bis zwei Wochen weitgehend ab. Nach einer Woche ist das Schlimmste meist im Abklingen.",
  "@inhalantsMilestone7Description": {"description": "Description for the inhalants recovery milestone at 7 days."},
  "inhalantsMilestone14Title": "Akutphase überwunden",
  "@inhalantsMilestone14Title": {"description": "Title for the inhalants recovery milestone at 14 days."},
  "inhalantsMilestone14Description": "Nach zwei Wochen ist die frühe Entzugsphase meist vorbei. Die Stimmung wird stabiler, auch wenn Benommenheit und Müdigkeit noch anhalten können.",
  "@inhalantsMilestone14Description": {"description": "Description for the inhalants recovery milestone at 14 days."},
  "inhalantsMilestone30Title": "Ein Monat — das Gehirn erholt sich",
  "@inhalantsMilestone30Title": {"description": "Title for the inhalants recovery milestone at 30 days."},
  "inhalantsMilestone30Description": "Nach einem Monat liegen die stärksten frühen Auswirkungen hinter dir, und Denken und Gedächtnis erholen sich. Klarheit und Stimmung verbessern sich.",
  "@inhalantsMilestone30Description": {"description": "Description for the inhalants recovery milestone at 30 days."},
  "inhalantsMilestone90Title": "Drei Monate Fortschritt",
  "@inhalantsMilestone90Title": {"description": "Title for the inhalants recovery milestone at 90 days."},
  "inhalantsMilestone90Description": "Drei Monate ohne Inhalationsmittel unterstützen die weitere Erholung von Gedächtnis, Aufmerksamkeit und Motorik. Die Fortschritte sind allmählich, aber real.",
  "@inhalantsMilestone90Description": {"description": "Description for the inhalants recovery milestone at 90 days."},
  "inhalantsMilestone365Title": "Ein Jahr — deutliche Erholung",
  "@inhalantsMilestone365Title": {"description": "Title for the inhalants recovery milestone at 365 days."},
  "inhalantsMilestone365Description": "Ein Jahr Abstinenz bringt bei den meisten Menschen eine deutliche neurologische Erholung; weitere Fortschritte werden bis ins zweite Jahr erwartet.",
  "@inhalantsMilestone365Description": {"description": "Description for the inhalants recovery milestone at 365 days."},
  "inhalantsMilestone730Title": "Zwei Jahre — langfristige Erholung",
  "@inhalantsMilestone730Title": {"description": "Title for the inhalants recovery milestone at 730 days."},
  "inhalantsMilestone730Description": "Nach zwei Jahren Abstinenz fanden Studien eine deutliche Erholung der Gehirnfunktion. Eine Ausnahme sind Schäden durch bleihaltiges Benzin, die fortbestehen können.",
  "@inhalantsMilestone730Description": {"description": "Description for the inhalants recovery milestone at 730 days."},
  "synthetic_cannabinoidsPageTitle": "Synth. Cannabinoide",
  "@synthetic_cannabinoidsPageTitle": {"description": "Title of the synthetic cannabinoids recovery page."},
  "synthetic_cannabinoidsHeaderStarted": "Ihre Recovery Journey",
  "@synthetic_cannabinoidsHeaderStarted": {"description": "Heading shown after synthetic cannabinoids tracking starts."},
  "synthetic_cannabinoidsHeaderNotStarted": "Vorteile des Beendens synthetischer Cannabinoide",
  "@synthetic_cannabinoidsHeaderNotStarted": {"description": "Heading shown before synthetic cannabinoids tracking starts."},
  "synthetic_cannabinoidsSubtitleStarted": "Verfolgen Sie Ihre Fortschritte und feiern Sie jeden Meilenstein",
  "@synthetic_cannabinoidsSubtitleStarted": {"description": "Subtitle shown after synthetic cannabinoids tracking starts."},
  "synthetic_cannabinoidsSubtitleNotStarted": "Sehen Sie, was passiert, wenn Sie aufhören",
  "@synthetic_cannabinoidsSubtitleNotStarted": {"description": "Subtitle shown before synthetic cannabinoids tracking starts."},
  "synthetic_cannabinoidsInfoBox": "Synthetische Cannabinoide („Spice“, „K2“) können deutlich stärker und unberechenbarer sein als Cannabis. Der Entzug kann schwerer verlaufen; berichtet wurden Krampfanfälle, starke Unruhe und Herzrasen, während eine akute Intoxikation auch Psychosen auslösen kann. Schwere Symptome brauchen sofortige medizinische Hilfe.",
  "@synthetic_cannabinoidsInfoBox": {"description": "Recovery information shown on the synthetic cannabinoids page."},
  "addictionSyntheticCannabinoids": "Synthetische Cannabinoide",
  "@addictionSyntheticCannabinoids": {"description": "Name of the synthetic cannabinoids addiction category."},
  "synthetic_cannabinoidsMilestone1Title": "Rückzug beginnt",
  "@synthetic_cannabinoidsMilestone1Title": {"description": "Title for the synthetic cannabinoids recovery milestone at 1 day."},
  "synthetic_cannabinoidsMilestone1Description": "Nach häufigem Konsum kann der Entzug schnell einsetzen. Schlafprobleme, Reizbarkeit, gedrückte Stimmung, Schwitzen, Herzklopfen, Unruhe und Zittern sind beschrieben – schwere Fälle können wiederkehrende Krampfanfälle sowie Herz-Kreislauf- oder Atemprobleme umfassen.",
  "@synthetic_cannabinoidsMilestone1Description": {"description": "Description for the synthetic cannabinoids recovery milestone at 1 day."},
  "synthetic_cannabinoidsMilestone3Title": "Der harte Anfang",
  "@synthetic_cannabinoidsMilestone3Title": {"description": "Title for the synthetic cannabinoids recovery milestone at 3 days."},
  "synthetic_cannabinoidsMilestone3Description": "Drei Tage geschafft. Der Entzug von synthetischen Cannabinoiden kann härter sein als bei hochpotentem Cannabis – diese frühe Phase ist kein Witz. Sie bringen bereits echten Abstand zwischen sich und die nächste Dosis.",
  "@synthetic_cannabinoidsMilestone3Description": {"description": "Description for the synthetic cannabinoids recovery milestone at 3 days."},
  "synthetic_cannabinoidsMilestone7Title": "Eine starke Woche",
  "@synthetic_cannabinoidsMilestone7Title": {"description": "Title for the synthetic cannabinoids recovery milestone at 7 days."},
  "synthetic_cannabinoidsMilestone7Description": "Eine Woche geschafft. Der Entzug von synthetischen Cannabinoiden kann schwer und körperlicher sein als Cannabisentzug. Sieben Tage ohne eine weitere Dosis sind ein echter Sieg.",
  "@synthetic_cannabinoidsMilestone7Description": {"description": "Description for the synthetic cannabinoids recovery milestone at 7 days."},
  "synthetic_cannabinoidsMilestone14Title": "Zwei Wochen frei",
  "@synthetic_cannabinoidsMilestone14Title": {"description": "Title for the synthetic cannabinoids recovery milestone at 14 days."},
  "synthetic_cannabinoidsMilestone14Description": "Zwei Wochen frei. Synthetische Cannabinoide sind eine eigene Liga: vierzehn Tage ohne erneute Exposition gegenüber einer Stoffklasse, die mit Krampfanfällen, Psychosen und Herzproblemen verbunden ist.",
  "@synthetic_cannabinoidsMilestone14Description": {"description": "Description for the synthetic cannabinoids recovery milestone at 14 days."},
  "synthetic_cannabinoidsMilestone30Title": "Ein Monat klar",
  "@synthetic_cannabinoidsMilestone30Title": {"description": "Title for the synthetic cannabinoids recovery milestone at 30 days."},
  "synthetic_cannabinoidsMilestone30Description": "Ein ganzer Monat frei. Dreißig Tage ohne erneute Exposition gegenüber der unberechenbaren Stärke und akuten Toxizität synthetischer Cannabinoide. Ein riesiger Meilenstein.",
  "@synthetic_cannabinoidsMilestone30Description": {"description": "Description for the synthetic cannabinoids recovery milestone at 30 days."},
  "synthetic_cannabinoidsMilestone90Title": "Drei Monate später",
  "@synthetic_cannabinoidsMilestone90Title": {"description": "Title for the synthetic cannabinoids recovery milestone at 90 days."},
  "synthetic_cannabinoidsMilestone90Description": "Drei Monate frei. Sie haben großen Abstand zu einer Stoffklasse gehalten, die mit schwerem Entzug, Krampfanfällen, Herz-Kreislauf-Problemen und Psychosen verbunden ist. Weiter so.",
  "@synthetic_cannabinoidsMilestone90Description": {"description": "Description for the synthetic cannabinoids recovery milestone at 90 days."},
  "synthetic_cannabinoidsMilestone180Title": "Ein halbes Jahr frei",
  "@synthetic_cannabinoidsMilestone180Title": {"description": "Title for the synthetic cannabinoids recovery milestone at 180 days."},
  "synthetic_cannabinoidsMilestone180Description": "Ein halbes Jahr frei. Sechs Monate ohne synthetische Cannabinoide sind gewaltig – sechs Monate ohne eine neue Runde ihrer unberechenbaren akuten Risiken.",
  "@synthetic_cannabinoidsMilestone180Description": {"description": "Description for the synthetic cannabinoids recovery milestone at 180 days."},
  "synthetic_cannabinoidsWithdrawalReference": "Entzug bei synthetischen Cannabinoiden\n\nQuelle: Craft et al. (2022), Psychopharmacology, PMC\n\nVon 284 Personen, die im Vorjahr mehr als zehnmal synthetische Cannabinoid-Rezeptoragonisten konsumiert und einen Absetzversuch unternommen hatten, berichteten 82,7 % nach mehr als einem Tag ohne Konsum mindestens ein Entzugssymptom. Am häufigsten waren Schlafprobleme (59,2 %), Reizbarkeit (55,6 %) und gedrückte Stimmung (54,2 %); außerdem wurden Schwitzen, Herzklopfen, Verlangen, Unruhe und Zittern genannt. Häufigerer und stärkerer Konsum war mit mehr Symptomen verbunden. Beim direkten Vergleich wurde der Entzug von synthetischen Cannabinoiden als schwerer als der von hochpotentem Cannabis bewertet.",
  "@synthetic_cannabinoidsWithdrawalReference": {"description": "Synthetic cannabinoids withdrawal reference."},
  "synthetic_cannabinoidsRiskReference": "Entzug und akute Risiken synthetischer Cannabinoide\n\nQuelle: Cooper (2016), Current Psychiatry Reports, PMC\n\nKlinische Berichte beschreiben nach täglichem Konsum einen rasch einsetzenden Entzug mit starker Angst, Schlaflosigkeit, Übelkeit und Erbrechen, Schwitzen, Herzklopfen, Zittern, Unruhe und Verlangen. Schwere Fälle umfassten wiederkehrende Krampfanfälle sowie Herz-Kreislauf- oder Atemprobleme. Der Review beschreibt auch die akute Wirkung als unberechenbar und teils schwerwiegend, einschließlich Psychosen, Krampfanfällen, Herzereignissen und Nierenschäden. Schwere oder zunehmende Symptome brauchen rasche medizinische Abklärung.",
  "@synthetic_cannabinoidsRiskReference": {"description": "Synthetic cannabinoids risk reference."},
  "synthetic_cannabinoidsMilestone730Title": "Zwei Jahre — Fester Boden",
  "@synthetic_cannabinoidsMilestone730Title": {"description": "Title for the synthetic cannabinoids recovery milestone at 730 days."},
  "synthetic_cannabinoidsMilestone730Description": "Zwei Jahre frei. Du hast 730 Tage geschafft, ohne zu synthetischen Cannabinoiden zurückzukehren. Diese Beständigkeit verdient eine echte Feier.",
  "@synthetic_cannabinoidsMilestone730Description": {"description": "Description for the synthetic cannabinoids recovery milestone at 730 days."},
  "synthetic_cannabinoidsMilestone1095Title": "Drei Jahre — Weiter stark",
  "@synthetic_cannabinoidsMilestone1095Title": {"description": "Title for the synthetic cannabinoids recovery milestone at 1095 days."},
  "synthetic_cannabinoidsMilestone1095Description": "Drei Jahre frei. Veränderung misst sich jetzt in Jahren, nicht in Tagen. Du entscheidest dich weiter für ein Leben ohne synthetische Cannabinoide.",
  "@synthetic_cannabinoidsMilestone1095Description": {"description": "Description for the synthetic cannabinoids recovery milestone at 1095 days."},
  "synthetic_cannabinoidsMilestone1460Title": "Vier Jahre — Dauerhaft stark",
  "@synthetic_cannabinoidsMilestone1460Title": {"description": "Title for the synthetic cannabinoids recovery milestone at 1460 days."},
  "synthetic_cannabinoidsMilestone1460Description": "Vier Jahre frei. Aus dem Aufhören ist etwas Dauerhaftes geworden: 1.460 Tage ohne synthetische Cannabinoide.",
  "@synthetic_cannabinoidsMilestone1460Description": {"description": "Description for the synthetic cannabinoids recovery milestone at 1460 days."},
  "synthetic_cannabinoidsMilestone1825Title": "Fünf Jahre — Ein halbes Jahrzehnt",
  "@synthetic_cannabinoidsMilestone1825Title": {"description": "Title for the synthetic cannabinoids recovery milestone at 1825 days."},
  "synthetic_cannabinoidsMilestone1825Description": "Fünf Jahre frei. Ein halbes Jahrzehnt ohne synthetische Cannabinoide ist ein riesiger langfristiger Erfolg. Darauf kannst du stolz sein.",
  "@synthetic_cannabinoidsMilestone1825Description": {"description": "Description for the synthetic cannabinoids recovery milestone at 1825 days."},
  "synthetic_cannabinoidsLongTermReference": "Synthetische Cannabinoide: Was die Evidenz stützt\n\nQuelle: Konsensusleitlinie der British Association for Psychopharmacology zur Behandlung von Substanzabhängigkeit (2026), PMC\n\nDie Leitlinie beschreibt, dass synthetische Cannabinoide ein schwereres Entzugssyndrom als Cannabis verursachen können und mitunter eine stationäre Entgiftung erfordern. Für Erhaltungstherapie oder Rückfallprävention bei synthetischen Cannabinoiden gibt es laut Leitlinie keine evidenzbasierte Pharmakotherapie.\n\nDie Leitlinie definiert keine biologische Erholungsschwelle nach 2, 3, 4 oder 5 Jahren. Diese Jahrestage feiern deshalb anhaltenden Fortschritt, ohne eine medizinische Frist zu behaupten, die durch die Evidenz nicht gestützt wird.",
  "@synthetic_cannabinoidsLongTermReference": {"description": "Synthetic cannabinoids long term reference."},
  "mdmaPageTitle": "MDMA",
  "@mdmaPageTitle": {"description": "Title of the mdma recovery page."},
  "mdmaHeaderStarted": "Ihre Recovery Journey",
  "@mdmaHeaderStarted": {"description": "Heading shown after mdma tracking starts."},
  "mdmaHeaderNotStarted": "Vorteile des Beendens von MDMA",
  "@mdmaHeaderNotStarted": {"description": "Heading shown before mdma tracking starts."},
  "mdmaSubtitleStarted": "Verfolgen Sie Ihre Fortschritte und feiern Sie jeden Meilenstein",
  "@mdmaSubtitleStarted": {"description": "Subtitle shown after mdma tracking starts."},
  "mdmaSubtitleNotStarted": "Sehen Sie, was passiert, wenn Sie aufhören",
  "@mdmaSubtitleNotStarted": {"description": "Subtitle shown before mdma tracking starts."},
  "mdmaInfoBox": "MDMA überschwemmt und erschöpft dann Serotonin, was den \"Comedown\" und nach starkem Gebrauch eine entzugsähnliche Stimmung erzeugt. Serotonin-Transporterspiegel erholen sich mit anhaltender Abstinenz, obwohl starker Gebrauch länger anhaltende Effekte hinterlassen kann.",
  "@mdmaInfoBox": {"description": "Recovery information shown on the mdma page."},
  "addictionMdma": "MDMA",
  "@addictionMdma": {"description": "Name of the mdma addiction category."},
  "mdmaMilestone1Title": "Der Comedown",
  "@mdmaMilestone1Title": {"description": "Title for the mdma recovery milestone at 1 day."},
  "mdmaMilestone1Description": "Nach MDMA kann der vorübergehende Serotoninabfall einen „Comedown“ auslösen: gedrückte Stimmung, Müdigkeit, Reizbarkeit und schlechter Schlaf für ein bis zwei Tage. Trinken, Essen und Ruhe helfen.",
  "@mdmaMilestone1Description": {"description": "Description for the mdma recovery milestone at 1 day."},
  "mdmaMilestone3Title": "Stimmung stabilisiert sich",
  "@mdmaMilestone3Title": {"description": "Title for the mdma recovery milestone at 3 days."},
  "mdmaMilestone3Description": "Nach einigen Tagen ist der stärkste Comedown meist vorbei. Stimmung und Energie beginnen sich wieder einzupendeln, während sich das Serotoninsystem erholt.",
  "@mdmaMilestone3Description": {"description": "Description for the mdma recovery milestone at 3 days."},
  "mdmaMilestone7Title": "Akutphase vorbei",
  "@mdmaMilestone7Title": {"description": "Title for the mdma recovery milestone at 7 days."},
  "mdmaMilestone7Description": "Nach stärkerem Konsum können entzugsähnliche Beschwerden wie gedrückte Stimmung, Konzentrationsprobleme und Suchtdruck etwa eine Woche anhalten, bevor sie nachlassen.",
  "@mdmaMilestone7Description": {"description": "Description for the mdma recovery milestone at 7 days."},
  "mdmaMilestone14Title": "Zwei Wochen",
  "@mdmaMilestone14Title": {"description": "Title for the mdma recovery milestone at 14 days."},
  "mdmaMilestone14Description": "Zwei Wochen ohne MDMA bringen typischerweise eine deutliche Verbesserung von Stimmung, Schlaf und Konzentration, während sich das Serotoninsystem weiter erholt.",
  "@mdmaMilestone14Description": {"description": "Description for the mdma recovery milestone at 14 days."},
  "mdmaMilestone30Title": "Ein Monat ohne MDMA",
  "@mdmaMilestone30Title": {"description": "Title for the mdma recovery milestone at 30 days."},
  "mdmaMilestone30Description": "Nach einem Monat sind Stimmung und Denken deutlich stabiler. Das Serotonin-Transportsystem des Gehirns erholt sich weiter, solange du MDMA meidest.",
  "@mdmaMilestone30Description": {"description": "Description for the mdma recovery milestone at 30 days."},
  "mdmaMilestone90Title": "Drei Monate",
  "@mdmaMilestone90Title": {"description": "Title for the mdma recovery milestone at 90 days."},
  "mdmaMilestone90Description": "Drei Monate ohne MDMA unterstützen die weitere Erholung des Serotoninsystems. Stimmung und Schlaf sind meist stabil, und Ängstlichkeit lässt in den folgenden Monaten häufig nach.",
  "@mdmaMilestone90Description": {"description": "Description for the mdma recovery milestone at 90 days."},
  "mdmaMilestone365Title": "Ein Jahr ohne MDMA",
  "@mdmaMilestone365Title": {"description": "Title for the mdma recovery milestone at 365 days."},
  "mdmaMilestone365Description": "Ein Jahr ohne MDMA. Serotoninfunktion und Stimmung hatten viel Zeit zur Erholung, und konsumbezogene Ängstlichkeit ist bis dahin typischerweise deutlich abgeklungen.",
  "@mdmaMilestone365Description": {"description": "Description for the mdma recovery milestone at 365 days."},
  "steroidsPageTitle": "Anabole Steroide",
  "@steroidsPageTitle": {"description": "Title of the steroids recovery page."},
  "steroidsHeaderStarted": "Ihre Recovery Journey",
  "@steroidsHeaderStarted": {"description": "Heading shown after steroids tracking starts."},
  "steroidsHeaderNotStarted": "Vorteile der Beendigung anabole Steroide",
  "@steroidsHeaderNotStarted": {"description": "Heading shown before steroids tracking starts."},
  "steroidsSubtitleStarted": "Verfolgen Sie Ihre Fortschritte und feiern Sie jeden Meilenstein",
  "@steroidsSubtitleStarted": {"description": "Subtitle shown after steroids tracking starts."},
  "steroidsSubtitleNotStarted": "Sehen Sie, was passiert, wenn Sie aufhören",
  "@steroidsSubtitleNotStarted": {"description": "Subtitle shown before steroids tracking starts."},
  "steroidsInfoBox": "Anabole Steroide stoppen lässt Testosteron niedrig, bis der Körper seine eigene Hormonproduktion wieder anfängt - normalerweise über Monate, aber manchmal länger. Depression und niedrige Libido sind in dieser Phase üblich; schwere Depressionen oder Selbstmordgedanken benötigen dringend medizinische Versorgung.",
  "@steroidsInfoBox": {"description": "Recovery information shown on the steroids page."},
  "addictionSteroids": "Anabole Steroide",
  "@addictionSteroids": {"description": "Name of the steroids addiction category."},
  "steroidsMilestone1Title": "Das Hormondefizit beginnt",
  "@steroidsMilestone1Title": {"description": "Title for the steroids recovery milestone at 1 day."},
  "steroidsMilestone1Description": "Anabole Steroide unterdrücken die körpereigene Testosteronproduktion. Nach dem Absetzen entsteht ein Hormonmangel, der Müdigkeit, gedrückte Stimmung und geringe Libido verursachen kann. Ärztliche Begleitung wird empfohlen.",
  "@steroidsMilestone1Description": {"description": "Description for the steroids recovery milestone at 1 day."},
  "steroidsMilestone14Title": "Anpassungsphase",
  "@steroidsMilestone14Title": {"description": "Title for the steroids recovery milestone at 14 days."},
  "steroidsMilestone14Description": "Die ersten Wochen sind oft die schwierigste Phase des Hormonabfalls: Energie, Stimmung und Libido können niedrig sein. Manche beginnen wieder mit Steroiden, um diese Beschwerden zu vermeiden; Unterstützung kann helfen, durch diese Phase zu kommen.",
  "@steroidsMilestone14Description": {"description": "Description for the steroids recovery milestone at 14 days."},
  "steroidsMilestone30Title": "Ein Monat — Hormonachse startet",
  "@steroidsMilestone30Title": {"description": "Title for the steroids recovery milestone at 30 days."},
  "steroidsMilestone30Description": "Nach einem Monat beginnt die Hormonachse zwischen Gehirn und Hoden wieder anzulaufen. Die steuernden Hormone und das Testosteron selbst steigen allmählich an, auch wenn gedrückte Stimmung, geringe Libido oder wenig Energie noch anhalten können.",
  "@steroidsMilestone30Description": {"description": "Description for the steroids recovery milestone at 30 days."},
  "steroidsMilestone90Title": "Drei Monate — Hormone steigen",
  "@steroidsMilestone90Title": {"description": "Title for the steroids recovery milestone at 90 days."},
  "steroidsMilestone90Description": "Nach drei Monaten steigen Testosteron und die steuernden Hormone bei vielen Menschen in Richtung Normalbereich. Stimmung und Libido bessern sich häufig mit.",
  "@steroidsMilestone90Description": {"description": "Description for the steroids recovery milestone at 90 days."},
  "steroidsMilestone180Title": "Sechs Monate — Erholung weit fort",
  "@steroidsMilestone180Title": {"description": "Title for the steroids recovery milestone at 180 days."},
  "steroidsMilestone180Description": "Nach sechs Monaten ist die hormonelle Erholung bei vielen Menschen weit fortgeschritten. Testosteron und seine Steuerhormone liegen häufig wieder im Normbereich, und Beschwerden lassen nach.",
  "@steroidsMilestone180Description": {"description": "Description for the steroids recovery milestone at 180 days."},
  "steroidsMilestone365Title": "Ein Jahr später",
  "@steroidsMilestone365Title": {"description": "Title for the steroids recovery milestone at 365 days."},
  "steroidsMilestone365Description": "Ein volles Jahr ohne Steroide ist ein riesiger Meilenstein. Die hormonelle Erholung verläuft oft über Monate; Hodengröße, Spermienproduktion und Libido können sich über Monate bis Jahre weiter erholen. Anhaltende Symptome eines Testosteronmangels sollten fachärztlich abgeklärt werden.",
  "@steroidsMilestone365Description": {"description": "Description for the steroids recovery milestone at 365 days."},
  "steroidsMilestone730Title": "Zwei Jahre – eine neue Normalität",
  "@steroidsMilestone730Title": {"description": "Title for the steroids recovery milestone at 730 days."},
  "steroidsMilestone730Description": "Zwei Jahre ohne Steroide. Die Erholung nach AAS ist unterschiedlich, aber Ihr eigenes Hormonsystem hatte viel Zeit zur Erholung. Wenn Symptome eines Testosteronmangels anhalten, lassen Sie sie fachärztlich abklären, statt einen weiteren Zyklus zu beginnen.",
  "@steroidsMilestone730Description": {"description": "Description for the steroids recovery milestone at 730 days."},
  "appTitle": "Quittung",
  "@appTitle": {"description": "The main application title"},
  "start": "Beginn",
  "@start": {"description": "Start."},
  "tabQuitter": "Quittung",
  "@tabQuitter": {"description": "Tab label for the main Quitter tab"},
  "adderallPageTitle": "Adderall verlassen",
  "@adderallPageTitle": {"description": "Title of the adderall recovery page."},
  "adderallHeaderStarted": "Ihre Recovery Journey",
  "@adderallHeaderStarted": {"description": "Heading shown after adderall tracking starts."},
  "adderallHeaderNotStarted": "Bereit, Ihre Genesung zu beginnen?",
  "@adderallHeaderNotStarted": {"description": "Heading shown before adderall tracking starts."},
  "adderallSubtitleStarted": "Verfolgen Sie Ihren Fortschritt und feiern Sie jeden Meilenstein, während Ihr Gehirn heilt",
  "@adderallSubtitleStarted": {"description": "Subtitle shown after adderall tracking starts."},
  "adderallSubtitleNotStarted": "Sehen Sie, was passiert, wenn Sie Adderall verlassen und Ihre Reise zur Genesung beginnen",
  "@adderallSubtitleNotStarted": {"description": "Subtitle shown before adderall tracking starts."},
  "adderallMilestone1Title": "Erste 24 Stunden: Entzug beginnt",
  "@adderallMilestone1Title": {"description": "Title for the adderall recovery milestone at 1 day."},
  "adderallMilestone1Description": "Während sich dein Körper an ein Leben ohne Stimulanzien anpasst, können Müdigkeit, depressive Stimmung und gesteigerter Appetit auftreten. Das ist normal und vorübergehend. Trink genug und ruh dich aus, wenn du es brauchst.",
  "@adderallMilestone1Description": {"description": "Description for the adderall recovery milestone at 1 day."},
  "adderallMilestone3Title": "Tag 3: Höhepunkt des Entzugs",
  "@adderallMilestone3Title": {"description": "Title for the adderall recovery milestone at 3 days."},
  "adderallMilestone3Description": "Die Entzugssymptome erreichen ihren Höhepunkt. Starke Müdigkeit, Reizbarkeit und Konzentrationsprobleme können auftreten. Das ist oft der schwierigste Abschnitt, aber von hier an wird es schrittweise besser. Nutze dein Unterstützungsnetz, wenn du es brauchst.",
  "@adderallMilestone3Description": {"description": "Description for the adderall recovery milestone at 3 days."},
  "adderallMilestone7Title": "Eine Woche: Körperliche Symptome lassen nach",
  "@adderallMilestone7Title": {"description": "Title for the adderall recovery milestone at 7 days."},
  "adderallMilestone7Description": "Die stärksten körperlichen Entzugssymptome beginnen nachzulassen. Der Schlaf normalisiert sich allmählich und die Energie kehrt langsam zurück. Dein Körper gewöhnt sich daran, ohne Stimulanzien zu funktionieren.",
  "@adderallMilestone7Description": {"description": "Description for the adderall recovery milestone at 7 days."},
  "adderallMilestone14Title": "Zwei Wochen: Mehr emotionale Stabilität",
  "@adderallMilestone14Title": {"description": "Title for the adderall recovery milestone at 14 days."},
  "adderallMilestone14Description": "Stimmungsschwankungen und Reizbarkeit nehmen ab. Während sich dein Gehirn weiter anpasst, kehrt mehr emotionale Stabilität zurück. Für viele Menschen fühlt sich diese Woche wie ein Wendepunkt der Erholung an.",
  "@adderallMilestone14Description": {"description": "Description for the adderall recovery milestone at 14 days."},
  "adderallMilestone30Title": "Ein Monat: Neues Gleichgewicht",
  "@adderallMilestone30Title": {"description": "Title for the adderall recovery milestone at 30 days."},
  "adderallMilestone30Description": "Dein Gehirn erholt sich weiter. Die natürliche Dopaminfunktion verbessert sich, und Konzentration und Motivation können ohne das Medikament leichter werden. Schlaf und Appetit nähern sich wieder ihrem normalen Muster.",
  "@adderallMilestone30Description": {"description": "Description for the adderall recovery milestone at 30 days."},
  "adderallMilestone60Title": "Zwei Monate: Denken und Gedächtnis",
  "@adderallMilestone60Title": {"description": "Title for the adderall recovery milestone at 60 days."},
  "adderallMilestone60Description": "Geistige Klarheit, Gedächtnis und Stimmung können sich deutlich verbessern. Das Belohnungssystem des Gehirns erholt sich, sodass alltägliche Aktivitäten wieder natürlicher befriedigend wirken. Viele Menschen fühlen sich zunehmend wieder wie sie selbst.",
  "@adderallMilestone60Description": {"description": "Description for the adderall recovery milestone at 60 days."},
  "adderallMilestone90Title": "Drei Monate: Wichtiger Erholungsmeilenstein",
  "@adderallMilestone90Title": {"description": "Title for the adderall recovery milestone at 90 days."},
  "adderallMilestone90Description": "Die meisten Entzugssymptome sind abgeklungen. Dein Gehirn hat große Fortschritte bei der Erholung gemacht. Energie, Konzentration und Emotionsregulation sind deutlich stabiler. Das ist ein Erfolg, den du feiern kannst.",
  "@adderallMilestone90Description": {"description": "Description for the adderall recovery milestone at 90 days."},
  "adderallMilestone180Title": "Sechs Monate: Gehirn erholt sich weiter",
  "@adderallMilestone180Title": {"description": "Title for the adderall recovery milestone at 180 days."},
  "adderallMilestone180Description": "Die Dopamin-Signalübertragung erholt sich weiter. Konzentration, Gedächtnis, Stimmung und Lebensqualität im Alltag können sich weiter verbessern.",
  "@adderallMilestone180Description": {"description": "Description for the adderall recovery milestone at 180 days."},
  "adderallMilestone365Title": "Ein Jahr: Weit fortgeschrittene Erholung",
  "@adderallMilestone365Title": {"description": "Title for the adderall recovery milestone at 365 days."},
  "adderallMilestone365Description": "Das Dopaminsystem deines Gehirns hat sich weitgehend erholt. Du hast Widerstandskraft bewiesen und dein Leben ohne Abhängigkeit von Stimulanzien neu aufgebaut. Feiere, wie weit du gekommen bist.",
  "@adderallMilestone365Description": {"description": "Description for the adderall recovery milestone at 365 days."},
  "benzoPageTitle": "Benzodiazepine",
  "@benzoPageTitle": {"description": "Title of the benzo recovery page."},
  "benzoHeaderStarted": "Ihre Recovery Journey",
  "@benzoHeaderStarted": {"description": "Heading shown after benzo tracking starts."},
  "benzoHeaderNotStarted": "Vorteile der Beendigung von Benzodiazepinen",
  "@benzoHeaderNotStarted": {"description": "Heading shown before benzo tracking starts."},
  "benzoSubtitleStarted": "Verfolgen Sie Ihre Fortschritte und feiern Sie jeden Meilenstein",
  "@benzoSubtitleStarted": {"description": "Subtitle shown after benzo tracking starts."},
  "benzoSubtitleNotStarted": "Sehen Sie, was passiert, wenn Sie aufhören",
  "@benzoSubtitleNotStarted": {"description": "Subtitle shown before benzo tracking starts."},
  "benzoMilestone7Title": "Woche 1: Beginn der Symptome",
  "@benzoMilestone7Title": {"description": "Title for the benzo recovery milestone at 7 days."},
  "benzoMilestone7Description": "Bis Tag 7 ist das gesamte typische Zeitfenster für den Beginn erreicht: Bei kurz wirksamen Benzodiazepinen beginnt der Entzug meist nach 1–2 Tagen, bei lang wirksamen nach 2–7 Tagen. Langsames Ausschleichen ist wichtig, weil es Krampfanfälle verhindern hilft.",
  "@benzoMilestone7Description": {"description": "Description for the benzo recovery milestone at 7 days."},
  "benzoMilestone14Title": "Zwei Wochen: Tiefschlaf erholt sich",
  "@benzoMilestone14Title": {"description": "Title for the benzo recovery milestone at 14 days."},
  "benzoMilestone14Description": "Etwa zwei Wochen nach einem schrittweisen Benzodiazepin-Entzug zeigte eine klinische Schlafstudie mehr Tiefschlaf und eine bessere subjektive Schlafqualität. Das ist ein konkretes frühes Erholungssignal für den Schlaf.",
  "@benzoMilestone14Description": {"description": "Description for the benzo recovery milestone at 14 days."},
  "benzoMilestone60Title": "Acht Wochen: Fokus & Gleichgewicht",
  "@benzoMilestone60Title": {"description": "Title for the benzo recovery milestone at 60 days."},
  "benzoMilestone60Description": "In einer 8-wöchigen Studie mit älteren Langzeitanwendern von Benzodiazepin-Schlafmitteln zeigten Teilnehmende nach abgeschlossenem Ausschleichen bessere Werte bei unmittelbarem Gedächtnis, Aufmerksamkeit, Sprache und Körperstabilität. Das ist messbare Erholung am Tag.",
  "@benzoMilestone60Description": {"description": "Description for the benzo recovery milestone at 60 days."},
  "benzoMilestone90Title": "Drei Monate: Klarer, weniger sediert",
  "@benzoMilestone90Title": {"description": "Title for the benzo recovery milestone at 90 days."},
  "benzoMilestone90Description": "Zwölf Wochen nach dem Ausschleichen erledigten langjährige Benzodiazepin-Nutzer, die erfolgreich abgesetzt hatten, zeitabhängige kognitive Aufgaben schneller und berichteten über weniger geistige und körperliche Sedierung als Personen, die weiterhin Benzodiazepine einnahmen. Das ist messbare Erholung im Alltag.",
  "@benzoMilestone90Description": {"description": "Description for the benzo recovery milestone at 90 days."},
  "benzoMilestone180Title": "Denken & Gedächtnis erholen sich",
  "@benzoMilestone180Title": {"description": "Title for the benzo recovery milestone at 180 days."},
  "benzoMilestone180Description": "Nach sechs Monaten zeigen Gedächtnis und Aufmerksamkeit eine messbare Verbesserung. Die Forschung findet Erholung in vielen Denkfähigkeiten, mit Gewinnen, die über sechs Monate hinausgehen.",
  "@benzoMilestone180Description": {"description": "Description for the benzo recovery milestone at 180 days."},
  "benzoMilestone365Title": "Ein Jahr Heilung",
  "@benzoMilestone365Title": {"description": "Title for the benzo recovery milestone at 365 days."},
  "benzoMilestone365Description": "Nach einem Jahr zeigen sich deutliche Verbesserungen des geistigen und körperlichen Wohlbefindens. Viele berichten von einer reduzierten Angst, einer besseren Schlafqualität und einer verbesserten allgemeinen Gesundheit im Vergleich zur langfristigen Einnahme von Benzodiazepinen. Die Gehirnheilung geht weiter.",
  "@benzoMilestone365Description": {"description": "Description for the benzo recovery milestone at 365 days."},
  "benzoMilestone540Title": "Weitere Erholung des Gehirns",
  "@benzoMilestone540Title": {"description": "Title for the benzo recovery milestone at 540 days."},
  "benzoMilestone540Description": "Nach 18 Monaten verbessern sich Gedächtnis, Aufmerksamkeit und klares Denken weiter. Das beruhigende GABA-System des Gehirns hatte weit über ein Jahr Zeit, sich zu beruhigen, während das Gehirn weiterhin gesündere Muster aufbaut.",
  "@benzoMilestone540Description": {"description": "Description for the benzo recovery milestone at 540 days."},
  "benzoMilestone730Title": "Zwei Jahre: Große Fortschritte",
  "@benzoMilestone730Title": {"description": "Title for the benzo recovery milestone at 730 days."},
  "benzoMilestone730Description": "Zwei Jahre markieren eine deutliche Erholung. Die meisten Menschen haben viel klareres Denken, stabilere Emotionen und eine viel bessere Lebensqualität als bei der langfristigen Verwendung von Benzodiazepin.",
  "@benzoMilestone730Description": {"description": "Description for the benzo recovery milestone at 730 days."},
  "benzoMilestone1095Title": "Drei Jahre: Langfristige Erholung",
  "@benzoMilestone1095Title": {"description": "Title for the benzo recovery milestone at 1095 days."},
  "benzoMilestone1095Description": "Nach drei Jahren liegt die lange Entzugsphase für die meisten Menschen weit zurück. Schlaf, Stimmung, Gedächtnis und Aufmerksamkeit hatten Jahre Zeit zur Erholung, und der Alltag ist meist deutlich besser als während der Langzeiteinnahme.",
  "@benzoMilestone1095Description": {"description": "Description for the benzo recovery milestone at 1095 days."},
  "benzoMilestone1460Title": "Vier Jahre: Starker Fortschritt",
  "@benzoMilestone1460Title": {"description": "Title for the benzo recovery milestone at 1460 days."},
  "benzoMilestone1460Description": "Vier Jahre ohne Benzodiazepine sind eine lange, Tag für Tag aufgebaute Erholungsstrecke. Da Erholung unterschiedlich verläuft, feiert dieser Jahrestag die Stabilität, Routinen und Widerstandskraft, die Sie gestärkt haben, ohne ein einheitliches Ziel für alle zu behaupten.",
  "@benzoMilestone1460Description": {"description": "Description for the benzo recovery milestone at 1460 days."},
  "benzoMilestone1825Title": "Fünf Jahre: Starkes Fundament",
  "@benzoMilestone1825Title": {"description": "Title for the benzo recovery milestone at 1825 days."},
  "benzoMilestone1825Description": "Fünf Jahre sind eine große langfristige Leistung. Erholung folgt keinem einheitlichen Zeitplan, doch fünf Jahre nachhaltiger Veränderung bedeuten Tausende Tage Übung, Unterstützung und ein Leben, das über Benzodiazepine hinaus aufgebaut wurde.",
  "@benzoMilestone1825Description": {"description": "Description for the benzo recovery milestone at 1825 days."},
  "addictionMeth": "Methamphetamin",
  "@addictionMeth": {"description": "Name of the meth addiction category."},
  "addictionBenzos": "Benzodiazepine",
  "@addictionBenzos": {"description": "Name of the benzos addiction category."},
  "methPageTitle": "Methamphetamin",
  "@methPageTitle": {"description": "Title of the meth recovery page."},
  "methHeaderStarted": "Ihre Recovery Journey",
  "@methHeaderStarted": {"description": "Heading shown after meth tracking starts."},
  "methHeaderNotStarted": "Lass das Glas fallen",
  "@methHeaderNotStarted": {"description": "Heading shown before meth tracking starts."},
  "methSubtitleStarted": "Verfolgen Sie Ihre Fortschritte und feiern Sie jeden Meilenstein",
  "@methSubtitleStarted": {"description": "Subtitle shown after meth tracking starts."},
  "methSubtitleNotStarted": "Freiheit ist in deiner Reichweite",
  "@methSubtitleNotStarted": {"description": "Subtitle shown before meth tracking starts."},
  "methMilestone1Title": "Erste 24 Stunden – der Crash beginnt",
  "@methMilestone1Title": {"description": "Title for the meth recovery milestone at 1 day."},
  "methMilestone1Description": "Die erste Crash-Phase beginnt mit starker Erschöpfung und mehr Appetit, während sich der Körper erholt. Depressive Stimmung und deutlich mehr Schlaf sind möglich, während sich der Organismus von der intensiven Stimulation stabilisiert.",
  "@methMilestone1Description": {"description": "Description for the meth recovery milestone at 1 day."},
  "methMilestone3Title": "Tag 3 – Höhepunkt des Entzugs",
  "@methMilestone3Title": {"description": "Title for the meth recovery milestone at 3 days."},
  "methMilestone3Description": "Das Verlangen nach Methamphetamin kann in dieser Phase deutlich stärker werden, während sich der Körper anpasst. Im Vergleich zur Crash-Phase kann die Energie wieder zunehmen, wodurch sich das Verlangen intensiver anfühlt. Rückfallprävention und Unterstützung sind jetzt besonders wichtig.",
  "@methMilestone3Description": {"description": "Description for the meth recovery milestone at 3 days."},
  "methMilestone7Title": "Eine Woche - körperlich besser",
  "@methMilestone7Title": {"description": "Title for the meth recovery milestone at 7 days."},
  "methMilestone7Description": "Akute Entzugssymptome beginnen nachzulassen, auch wenn psychische Belastungen bleiben. Der Schlaf normalisiert sich langsam und körperliche Beschwerden nehmen ab. Damit beginnt der Übergang von der akuten zur postakuten Entzugsphase.",
  "@methMilestone7Description": {"description": "Description for the meth recovery milestone at 7 days."},
  "methMilestone30Title": "Ein Monat – mehr Stabilität",
  "@methMilestone30Title": {"description": "Title for the meth recovery milestone at 30 days."},
  "methMilestone30Description": "Der Körper erholt sich weiter und das Verlangen nach Methamphetamin lässt nach. Energie und Stimmung verbessern sich, während sich die Gehirnchemie neu einpendelt. Trotzdem können weiterhin schwierige Phasen auftreten.",
  "@methMilestone30Description": {"description": "Description for the meth recovery milestone at 30 days."},
  "methMilestone90Title": "Drei Monate – Gehirnerholung beginnt",
  "@methMilestone90Title": {"description": "Title for the meth recovery milestone at 90 days."},
  "methMilestone90Description": "Das Gehirn erholt sich weiter. Aufmerksamkeit, Gedächtnis und Entscheidungsfähigkeit können sich verbessern, während sich das Belohnungssystem wieder einem normaleren Zustand annähert.",
  "@methMilestone90Description": {"description": "Description for the meth recovery milestone at 90 days."},
  "methMilestone180Title": "Sechs Monate - Herzerholung",
  "@methMilestone180Title": {"description": "Title for the meth recovery milestone at 180 days."},
  "methMilestone180Description": "Nach dem Absetzen von Methamphetamin kann sich die Herzfunktion messbar verbessern. Studien zeigen, dass sich die Herzleistung in dieser Zeit besonders mit medizinischer Unterstützung deutlich erholen kann. Blutdruck und Herzrhythmus können sich weiter stabilisieren.",
  "@methMilestone180Description": {"description": "Description for the meth recovery milestone at 180 days."},
  "methMilestone365Title": "Ein Jahr – deutliche Gehirnerholung",
  "@methMilestone365Title": {"description": "Title for the meth recovery milestone at 365 days."},
  "methMilestone365Description": "Nach einem Jahr hat sich das Dopaminsystem deutlich erholt. Alltägliche Belohnungen können wieder stärker wirken, während Stimmung, Gedächtnis und Entscheidungsfähigkeit klar besser sind.",
  "@methMilestone365Description": {"description": "Description for the meth recovery milestone at 365 days."},
  "methMilestone420Title": "14 Monate - Dopamin erholt sich",
  "@methMilestone420Title": {"description": "Title for the meth recovery milestone at 420 days."},
  "methMilestone420Description": "Hirnscans zeigen, dass sich Proteine für die Wiederaufnahme von Dopamin in dieser Phase gesunden Werten annähern. Gedächtnis, Motivation und die Fähigkeit, alltägliche Aktivitäten zu genießen, können sich weiter verbessern.",
  "@methMilestone420Description": {"description": "Description for the meth recovery milestone at 420 days."},
  "methMilestone730Title": "Zwei Jahre – anhaltende Erholung",
  "@methMilestone730Title": {"description": "Title for the meth recovery milestone at 730 days."},
  "methMilestone730Description": "Zwei Jahre ohne Methamphetamin geben dem Gehirn lange Zeit für weitere Erholung. Aufmerksamkeit, Stimmung, Gedächtnis und die Lebensqualität im Alltag können sich weiter verbessern.",
  "@methMilestone730Description": {"description": "Description for the meth recovery milestone at 730 days."},
  "addictionNitrousOxide": "Stickoxide",
  "@addictionNitrousOxide": {"description": "Name of the nitrous oxide addiction category."},
  "nitrousOxidePageTitle": "Lachgas",
  "@nitrousOxidePageTitle": {"description": "Title of the nitrous oxide recovery page."},
  "nitrousOxideHeaderStarted": "Ihre Recovery Journey",
  "@nitrousOxideHeaderStarted": {"description": "Heading shown after nitrous oxide tracking starts."},
  "nitrousOxideHeaderNotStarted": "Bereit zum Start?",
  "@nitrousOxideHeaderNotStarted": {"description": "Heading shown before nitrous oxide tracking starts."},
  "nitrousOxideSubtitleStarted": "Verfolgen Sie Ihre Fortschritte und feiern Sie jeden Meilenstein",
  "@nitrousOxideSubtitleStarted": {"description": "Subtitle shown after nitrous oxide tracking starts."},
  "nitrousOxideSubtitleNotStarted": "Sehen Sie, welche positiven Veränderungen Sie erwarten",
  "@nitrousOxideSubtitleNotStarted": {"description": "Subtitle shown before nitrous oxide tracking starts."},
  "nitrousOxideMilestone1Title": "Erste 24 Std. – Gas ist raus",
  "@nitrousOxideMilestone1Title": {"description": "Title for the nitrous oxide recovery milestone at 1 day."},
  "nitrousOxideMilestone1Description": "Das Gas verlässt den Körper innerhalb weniger Minuten, doch die Erholung braucht länger. Schwindel lässt nach, Kopfschmerzen werden schwächer und das Gehirn beginnt, sich ohne den Dopamin-Kick anzupassen. Die Erholung des B12-Haushalts beginnt jetzt.",
  "@nitrousOxideMilestone1Description": {"description": "Description for the nitrous oxide recovery milestone at 1 day."},
  "nitrousOxideMilestone3Title": "Tag 3 – Kein körperlicher Entzug",
  "@nitrousOxideMilestone3Title": {"description": "Title for the nitrous oxide recovery milestone at 3 days."},
  "nitrousOxideMilestone3Description": "Die gute Nachricht: Lachgas verursacht keinen körperlichen Entzug. Was du als Drang spürst, ist psychologisch geprägt – Gewohnheit und Verknüpfungen, nicht ein Körper, der eine Substanz verlangt. Das macht diesen Drang handhabbar.",
  "@nitrousOxideMilestone3Description": {"description": "Description for the nitrous oxide recovery milestone at 3 days."},
  "nitrousOxideMilestone7Title": "Eine Woche – B12 steigt wieder",
  "@nitrousOxideMilestone7Title": {"description": "Title for the nitrous oxide recovery milestone at 7 days."},
  "nitrousOxideMilestone7Description": "Seit einer Woche wird kein weiteres B12 durch neue Lachgasexposition inaktiviert. Wenn du mit einer Supplementierung begonnen hast, können die Werte bereits steigen. Energie, Stimmung und Konzentration hängen mit B12 zusammen – erste Verbesserungen können spürbar werden.",
  "@nitrousOxideMilestone7Description": {"description": "Description for the nitrous oxide recovery milestone at 7 days."},
  "nitrousOxideMilestone14Title": "Zwei Wochen – Nerven erholen sich",
  "@nitrousOxideMilestone14Title": {"description": "Title for the nitrous oxide recovery milestone at 14 days."},
  "nitrousOxideMilestone14Description": "B12 ist für die schützende Hülle der Nervenfasern wichtig. Nach zwei Wochen läuft dieser Reparaturprozess. Kribbeln oder Taubheitsgefühle können nachlassen – dein Nervensystem arbeitet an der Erholung.",
  "@nitrousOxideMilestone14Description": {"description": "Description for the nitrous oxide recovery milestone at 14 days."},
  "nitrousOxideMilestone30Title": "Ein Monat – Energie kehrt zurück",
  "@nitrousOxideMilestone30Title": {"description": "Title for the nitrous oxide recovery milestone at 30 days."},
  "nitrousOxideMilestone30Description": "B12 spielt eine wichtige Rolle bei der Bildung roter Blutkörperchen und damit bei der Sauerstoffversorgung der Zellen. Ein Monat Erholung und gegebenenfalls Supplementierung kann mehr Energie, klareres Denken und eine stabilere Stimmung bedeuten.",
  "@nitrousOxideMilestone30Description": {"description": "Description for the nitrous oxide recovery milestone at 30 days."},
  "nitrousOxideMilestone90Title": "Drei Monate – Nerven erholen sich",
  "@nitrousOxideMilestone90Title": {"description": "Title for the nitrous oxide recovery milestone at 90 days."},
  "nitrousOxideMilestone90Description": "Drei Monate ohne neue B12-Inaktivierung bedeuten drei Monate Zeit für die Erholung der Nerven. Das Nervensystem ist anpassungsfähig; bei früh behandeltem Schaden wird bis dahin häufig eine deutliche Besserung von Kribbeln, Schwäche und Konzentrationsproblemen berichtet.",
  "@nitrousOxideMilestone90Description": {"description": "Description for the nitrous oxide recovery milestone at 90 days."},
  "nitrousOxideMilestone365Title": "Ein Jahr – Langfristig geschützt",
  "@nitrousOxideMilestone365Title": {"description": "Title for the nitrous oxide recovery milestone at 365 days."},
  "nitrousOxideMilestone365Description": "Ein ganzes Jahr ohne Lachgas. Deine B12-Speicher sind wiederhergestellt, dein Nervensystem hatte ein Jahr Zeit zur Erholung und das kardiovaskuläre Risiko durch erhöhtes Homocystein ist abgeklungen. Dein Körper arbeitet wieder mit seiner eigenen Chemie.",
  "@nitrousOxideMilestone365Description": {"description": "Description for the nitrous oxide recovery milestone at 365 days."},
