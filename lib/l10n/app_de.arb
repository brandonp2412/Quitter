  "@opioidMilestone90Description": {"description": "Opioid milestone day 90 description"},
  "opioidMilestone180Title": "Das Immunsystem gewinnt an Kraft",
  "@opioidMilestone180Title": {"description": "Opioid milestone day 180 title"},
