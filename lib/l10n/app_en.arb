    "description": "Encouragement message for relapse"
  },
  "relapseMessage10": "Being here shows you haven't given up. That's powerful.",
  "@relapseMessage10": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage11": "Progress isn't about perfection—it's about persistence.",
