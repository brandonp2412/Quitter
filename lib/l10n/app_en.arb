  "@opioidMilestone30Title": {
    "description": "Opioid milestone day 30 title"
  },
  "opioidMilestone30Description": "Thirty days. Thinking and concentration may start improving as recovery goes on. Support and treatment are part of the win.",
  "@opioidMilestone30Description": {
    "description": "Opioid milestone day 30 description"
  },
  "opioidMilestone60Title": "Two months, more balance",
