{
  "showUpdateNotices": "Show update notices",
  "@showUpdateNotices": {"description": "Whether to show update notices after upgrading the app."},
  "kratomPageTitle": "Kratom Recovery",
  "kratomHeaderStarted": "Your Recovery Journey",
  "kratomHeaderNotStarted": "Benefits of Quitting Kratom",
  "kratomSubtitleStarted": "Track your progress and celebrate each milestone",
  "kratomSubtitleNotStarted": "See what happens when you quit",
  "kratomInfoBox": "Kratom acts on opioid receptors, so stopping can produce an opioid-like withdrawal. If you use heavily or alongside other opioids, ask a clinician about medically supervised withdrawal.",
  "addictionKratom": "Kratom",
  "kratomMilestone1Title": "First day without kratom",
  "kratomMilestone1Description": "The first day can be rough. Restlessness, sweating and aches may be kicking in as your body adjusts.",
  "kratomMilestone3Title": "The rough patch",
  "kratomMilestone3Description": "Days two and three can bring the worst of the aches, poor sleep and stomach trouble. It's a rotten stretch. Support and rest matter.",
  "kratomMilestone7Title": "A week clear",
  "kratomMilestone7Description": "Seven days without kratom. The early physical symptoms may be easing, even if sleep and energy haven't caught up yet.",
  "kratomMilestone14Title": "Two weeks in",
  "kratomMilestone14Description": "Two weeks down. Sleep and mood may be settling, though recovery doesn't run to a tidy schedule.",
  "kratomMilestone30Title": "A whole month",
  "kratomMilestone30Description": "Thirty days without kratom. You've had time to find new routines, and sleep, appetite or energy may be improving.",
  "kratomMilestone90Title": "Three months clear",
  "kratomMilestone90Description": "Three months. Cravings and difficult days can still turn up, but you've had real practice getting through them without kratom.",
  "kratomMilestone365Title": "A year without kratom",
  "kratomMilestone365Description": "A whole year. You've handled every season without going back to kratom.",
  "kratomMilestone730Title": "Two years",
  "kratomMilestone730Description": "Two years without kratom. You've handled what the past couple of years threw at you without going back.",
  "kratomMilestone1095Title": "Three years of your own",
  "kratomMilestone1095Description": "Three years without kratom. The routines you've built have had plenty of time to become yours.",
  "kratomMilestone1460Title": "Four years, still clear",
  "kratomMilestone1460Description": "Four years. The habit that used to take up space in your day hasn't had a say for a long time.",
  "kratomMilestone1825Title": "Five years",
  "kratomMilestone1825Description": "You've kept kratom out of your life for five years, through stress, changes and ordinary Tuesdays.",
  "gabapentinoidsPageTitle": "Gabapentinoids",
  "gabapentinoidsHeaderStarted": "Your Recovery Journey",
  "gabapentinoidsHeaderNotStarted": "Benefits of Quitting Gabapentin / Pregabalin",
  "gabapentinoidsSubtitleStarted": "Track your progress and celebrate each milestone",
  "gabapentinoidsSubtitleNotStarted": "See what happens when you quit",
  "gabapentinoidsInfoBox": "Never stop gabapentin or pregabalin abruptly. Sudden discontinuation can trigger seizures — especially if you take them for epilepsy. A gradual, medically supervised taper is essential.",
  "addictionGabapentinoid": "Gabapentin / Pregabalin",
  "ghbPageTitle": "GHB Recovery",
  "ghbHeaderStarted": "Your Recovery Journey",
  "ghbHeaderNotStarted": "Benefits of Quitting GHB",
  "ghbSubtitleStarted": "Track your progress and celebrate each milestone",
  "ghbSubtitleNotStarted": "See what happens when you quit",
  "ghbInfoBox": "GHB withdrawal is a medical emergency — it rivals alcohol and benzodiazepine withdrawal and can cause delirium and seizures. Heavy or around-the-clock users should not stop without supervised inpatient detox.",
  "addictionGhb": "GHB",
  "ghbMilestone1Title": "Get medical help",
  "ghbMilestone1Description": "GHB withdrawal can start within hours and turn dangerous quickly. Shaking, agitation or a racing heart need medical assessment. Don't try to tough this one out alone.",
  "ghbMilestone3Title": "A serious few days",
  "ghbMilestone3Description": "Severe GHB withdrawal can involve delirium, hallucinations and seizures. If you're in this window, medical supervision matters more than any milestone.",
  "ghbMilestone7Title": "One week through",
  "ghbMilestone7Description": "A week without GHB. The acute phase may be easing, but severe withdrawal can last longer. Keep medical support in the picture.",
  "ghbMilestone14Title": "Two weeks clear",
  "ghbMilestone14Description": "Two weeks is a big early step. Sleep and anxiety may still be difficult after acute withdrawal, and that's worth discussing with your care team.",
  "ghbMilestone30Title": "A month without GHB",
  "ghbMilestone30Description": "Thirty days. The dangerous early period may be behind you, while sleep and mood take their own time to settle.",
  "ghbMilestone90Title": "Three months on",
  "ghbMilestone90Description": "Three months away from GHB. Whether it's sleep, anxiety or everyday routines, you've given yourself a proper stretch to work on them.",
  "ghbMilestone180Title": "Half a year clear",
  "ghbMilestone180Description": "Six months. A lot of life has happened without GHB in it. Recovery may still need work.",
  "ketaminePageTitle": "Ketamine Recovery",
  "ketamineHeaderStarted": "Your Recovery Journey",
  "ketamineHeaderNotStarted": "Benefits of Quitting Ketamine",
  "ketamineSubtitleStarted": "Track your progress and celebrate each milestone",
  "ketamineSubtitleNotStarted": "See what happens when you quit",
  "ketamineInfoBox": "Ketamine withdrawal is mainly cravings, low mood, and brain fog rather than physical illness. Its biggest physical harm is bladder damage, and stopping is the essential first step toward recovery.",
  "addictionKetamine": "Ketamine",
  "ketamineMilestone1Title": "First day off ketamine",
  "ketamineMilestone1Description": "Day one can bring cravings, low mood or restlessness. The drug may clear quickly; the habits around it can take longer to change.",
  "ketamineMilestone7Title": "A week clear",
  "ketamineMilestone7Description": "Seven days without ketamine. Cravings and a foggy head may still be hanging around, but you've made it through a full week.",
  "ketamineMilestone14Title": "Two weeks, more space",
  "ketamineMilestone14Description": "Two weeks away from ketamine. Thinking and mood may be clearer, though everyone's recovery looks different.",
  "ketamineMilestone30Title": "A month for recovery",
  "ketamineMilestone30Description": "A month without ketamine gives your body a break from further exposure. Bladder symptoms can improve after stopping, but persistent pain or urgency needs medical care.",
  "ketamineMilestone90Title": "Three months clear",
  "ketamineMilestone90Description": "Three months without ketamine. You've given your bladder and your thinking more time to recover. Some damage needs treatment, so don't ignore symptoms.",
  "ketamineMilestone180Title": "Six months without it",
  "ketamineMilestone180Description": "Half a year. The pull of the old habit may be changing, and you've avoided six more months of ketamine-related harm.",
  "ketamineMilestone365Title": "A year clear",
  "ketamineMilestone365Description": "A full year without ketamine. That's a lot of time for recovery and a lot of days without renewed exposure.",
  "ketamineMilestone730Title": "Two years, still clear",
  "ketamineMilestone730Description": "Two years without ketamine. Recovery from bladder or cognitive problems varies, but staying away avoids adding to the damage.",
  "ketamineMilestone1095Title": "Three years of distance",
  "ketamineMilestone1095Description": "Three years without ketamine. You've kept the change going through everyday life.",
  "ketamineMilestone1460Title": "Four years",
  "ketamineMilestone1460Description": "Four years without ketamine. You've kept this going long past the point where it was new.",
  "ketamineMilestone1825Title": "Five years",
  "ketamineMilestone1825Description": "Half a decade without ketamine. Whatever recovery has looked like for you, five years of sustained change is worth celebrating properly.",
  "inhalantsPageTitle": "Inhalants Recovery",
  "inhalantsHeaderStarted": "Your Recovery Journey",
  "inhalantsHeaderNotStarted": "Benefits of Quitting Inhalants",
  "inhalantsSubtitleStarted": "Track your progress and celebrate each milestone",
  "inhalantsSubtitleNotStarted": "See what happens when you quit",
  "inhalantsInfoBox": "Inhalant withdrawal is shorter than alcohol or opioids but can be intense, with seizure risk in heavy users. Neurological recovery is real but slow — often unfolding over about two years of abstinence.",
  "addictionInhalants": "Inhalants",
  "inhalantsMilestone1Title": "First day away",
  "inhalantsMilestone1Description": "One day without inhalants. Headaches, nausea or anxiety can show up early. Some effects need medical attention, especially confusion or breathing problems.",
  "inhalantsMilestone7Title": "A week clear",
  "inhalantsMilestone7Description": "Seven days without another exposure. Early symptoms may be easing, though thinking, mood or coordination can take longer to improve.",
  "inhalantsMilestone14Title": "Two weeks, no new exposure",
  "inhalantsMilestone14Description": "Two weeks. You've stopped adding more exposure while your body recovers. If memory or movement still feels off, get it checked.",
  "inhalantsMilestone30Title": "A month of breathing room",
  "inhalantsMilestone30Description": "A full month without inhalants. Thinking and attention may improve with abstinence, but some nerve or brain injuries need specialist care.",
  "inhalantsMilestone90Title": "Three months clear",
  "inhalantsMilestone90Description": "Three months of keeping inhalants out of the picture. Recovery in attention, memory and movement can take time and isn't the same for everyone.",
  "inhalantsMilestone365Title": "A year without inhalants",
  "inhalantsMilestone365Description": "A year clear. That's 365 days without renewed chemical exposure. Neurological recovery varies, but this choice matters.",
  "inhalantsMilestone730Title": "Two years",
  "inhalantsMilestone730Description": "Two years without inhalants. Studies have seen brain-function improvements over longer abstinence, though some injuries can persist. You've done the part you can control.",
  "synthetic_cannabinoidsPageTitle": "Synthetic Cannabinoids",
  "synthetic_cannabinoidsHeaderStarted": "Your Recovery Journey",
  "synthetic_cannabinoidsHeaderNotStarted": "Benefits of Quitting Synthetic Cannabinoids",
  "synthetic_cannabinoidsSubtitleStarted": "Track your progress and celebrate each milestone",
  "synthetic_cannabinoidsSubtitleNotStarted": "See what happens when you quit",
  "synthetic_cannabinoidsInfoBox": "Synthetic cannabinoids (“Spice”, “K2”) can be far more potent and unpredictable than cannabis. Withdrawal can be more severe, with seizures, agitation, and a fast heart rate reported; acute intoxication can also cause psychosis. Severe symptoms need urgent medical care.",
  "addictionSyntheticCannabinoids": "Synthetic Cannabinoids",
  "synthetic_cannabinoidsMilestone1Title": "Day one: stay safe",
  "synthetic_cannabinoidsMilestone1Description": "Withdrawal from synthetic cannabinoids can be intense. Shaking, palpitations or poor sleep may occur; seizures, chest pain or severe confusion need urgent medical attention.",
  "synthetic_cannabinoidsMilestone3Title": "Three days clear",
  "synthetic_cannabinoidsMilestone3Description": "The early stretch can be nasty, and synthetic-cannabinoid withdrawal may be harsher than cannabis withdrawal. Three days without another dose is a real start.",
  "synthetic_cannabinoidsMilestone7Title": "A week away",
  "synthetic_cannabinoidsMilestone7Description": "Seven days clear. You haven't exposed yourself again to a drug class known for wildly unpredictable effects.",
  "synthetic_cannabinoidsMilestone14Title": "Two Weeks Clear",
  "synthetic_cannabinoidsMilestone14Description": "Two weeks without synthetic cannabinoids. You've avoided another fortnight of their unpredictable risks. Keep taking any lingering symptoms seriously.",
  "synthetic_cannabinoidsMilestone30Title": "A month",
  "synthetic_cannabinoidsMilestone30Description": "Thirty days without synthetic cannabinoids. A full month away from the seizures, heart problems and other acute risks linked to their use.",
  "synthetic_cannabinoidsMilestone90Title": "Three months of distance",
  "synthetic_cannabinoidsMilestone90Description": "Three months clear. That's a decent chunk of life without rolling the dice on what might be in the next dose.",
  "synthetic_cannabinoidsMilestone180Title": "Half a year clear",
  "synthetic_cannabinoidsMilestone180Description": "Six months without synthetic cannabinoids. You've avoided renewed exposure while building steadier routines.",
  "synthetic_cannabinoidsWithdrawalReference": "Synthetic Cannabinoid Withdrawal\n\nSource: Craft et al. (2022), Psychopharmacology, PMC\n\nIn 284 people who had used synthetic cannabinoid receptor agonists more than 10 times in the previous year and tried to stop, 82.7% reported at least one withdrawal symptom after more than a day without use. Sleep problems (59.2%), irritability (55.6%), and low mood (54.2%) were most common; sweating, palpitations, craving, agitation, and shakiness were also reported. More frequent and heavier use was linked to more symptoms. Among participants who compared both drugs, synthetic-cannabinoid withdrawal was rated more severe than withdrawal from high-potency cannabis.",
  "synthetic_cannabinoidsRiskReference": "Synthetic Cannabinoid Withdrawal and Acute Risk\n\nSource: Cooper (2016), Current Psychiatry Reports, PMC\n\nClinical reports describe withdrawal after daily synthetic-cannabinoid use occurring soon after the last dose, with severe anxiety, insomnia, nausea and vomiting, sweating, palpitations, tremor, agitation, and cravings. Severe cases have included recurring seizures and cardiovascular or breathing problems. The review also describes synthetic-cannabinoid intoxication as unpredictable and sometimes severe, including psychosis, seizures, cardiac events, and kidney injury. Severe or escalating symptoms need prompt medical assessment.",
  "synthetic_cannabinoidsMilestone730Title": "Two years",
  "synthetic_cannabinoidsMilestone730Description": "Two years clear. Holidays, bad days and everything in between, without returning to synthetic cannabinoids.",
  "synthetic_cannabinoidsMilestone1095Title": "Three years without it",
  "synthetic_cannabinoidsMilestone1095Description": "Three years without synthetic cannabinoids. You've kept the change going well beyond early recovery.",
  "synthetic_cannabinoidsMilestone1460Title": "Four years, still free",
  "synthetic_cannabinoidsMilestone1460Description": "Four years away from synthetic cannabinoids. The new routines have had a lot of time to stick, and you've kept protecting them.",
  "synthetic_cannabinoidsMilestone1825Title": "Five years",
  "synthetic_cannabinoidsMilestone1825Description": "Half a decade without synthetic cannabinoids. That's a huge amount of life lived without their unpredictable risks.",
  "synthetic_cannabinoidsLongTermReference": "Synthetic Cannabinoids: What the Evidence Supports\n\nSource: British Association for Psychopharmacology consensus guidelines on substance dependence (2026), PMC\n\nThe guideline says synthetic cannabinoids can produce a more severe withdrawal syndrome than cannabis and may require inpatient detoxification. It also states that there is no evidence-based pharmacotherapy for maintenance or relapse prevention for synthetic cannabinoids.\n\nThe guideline does not define a 2-, 3-, 4-, or 5-year biological recovery threshold. These anniversaries therefore celebrate sustained progress without claiming a medical deadline that the evidence does not support.",
  "mdmaPageTitle": "MDMA Recovery",
  "mdmaHeaderStarted": "Your Recovery Journey",
  "mdmaHeaderNotStarted": "Benefits of Quitting MDMA",
  "mdmaSubtitleStarted": "Track your progress and celebrate each milestone",
  "mdmaSubtitleNotStarted": "See what happens when you quit",
  "mdmaInfoBox": "MDMA floods and then depletes serotonin, producing the “comedown” and, after heavy use, withdrawal-like low mood. Serotonin transporter levels recover with sustained abstinence, though heavy use can leave longer-lasting effects.",
  "addictionMdma": "MDMA",
  "mdmaMilestone1Title": "The Comedown",
  "mdmaMilestone1Description": "The first day after MDMA can feel flat. Tiredness, low mood and poor sleep are common after-effects. Food, rest and support can help.",
  "mdmaMilestone3Title": "Past the first few days",
  "mdmaMilestone3Description": "A few days clear. The sharpest comedown may be easing, even if your mood or sleep hasn't quite found its feet.",
  "mdmaMilestone7Title": "A week without MDMA",
  "mdmaMilestone7Description": "Seven days. After heavier use, low mood, cravings and poor focus can linger. You've given yourself a full week without another dose.",
  "mdmaMilestone14Title": "Two weeks without MDMA",
  "mdmaMilestone14Description": "Two weeks without MDMA. Sleep, mood and focus may be improving. Recovery takes different amounts of time for different people.",
  "mdmaMilestone30Title": "A month clear",
  "mdmaMilestone30Description": "A whole month. You've had some distance from the comedown cycle and time to settle into different routines.",
  "mdmaMilestone90Title": "Three Months On",
  "mdmaMilestone90Description": "Three months without MDMA. That's a proper stretch away from repeated exposure, while mood and sleep have had more time to recover.",
  "mdmaMilestone365Title": "A full year off MDMA",
  "mdmaMilestone365Description": "One year without MDMA, through every birthday, weekend and ordinary day in between.",
  "steroidsPageTitle": "Anabolic Steroids",
  "steroidsHeaderStarted": "Your Recovery Journey",
  "steroidsHeaderNotStarted": "Benefits of Quitting Anabolic Steroids",
  "steroidsSubtitleStarted": "Track your progress and celebrate each milestone",
  "steroidsSubtitleNotStarted": "See what happens when you quit",
  "steroidsInfoBox": "Stopping anabolic steroids leaves testosterone low until the body restarts its own hormone production — usually over months, but sometimes longer. Depression and low libido are common during this phase; severe depression or suicidal thoughts need urgent medical care.",
  "addictionSteroids": "Anabolic Steroids",
  "steroidsMilestone1Title": "First day off cycle",
  "steroidsMilestone1Description": "Stopping anabolic steroids can leave your natural testosterone low, with fatigue, low mood or libido changes. Medical guidance matters here.",
  "steroidsMilestone14Title": "The hormone dip",
  "steroidsMilestone14Description": "Two weeks without another cycle. Energy, mood and libido can be rough while hormones adjust. There's no shame in getting help with it.",
  "steroidsMilestone30Title": "A month off steroids",
  "steroidsMilestone30Description": "Thirty days. Your hormone system may be starting to recover, though symptoms can last and the pace varies.",
  "steroidsMilestone90Title": "Three months off",
  "steroidsMilestone90Description": "Three months without anabolic steroids. Hormone levels and mood may be improving, but persistent symptoms deserve a proper medical check.",
  "steroidsMilestone180Title": "Six months clear",
  "steroidsMilestone180Description": "Half a year off cycle. Many people see hormone recovery over months, while others need longer or specialist care.",
  "steroidsMilestone365Title": "One year, no cycle",
  "steroidsMilestone365Description": "A full year without anabolic steroids. Hormones and fertility can take months or years to recover. The year you've put in still matters.",
  "steroidsMilestone730Title": "Two years off",
  "steroidsMilestone730Description": "Two years without another cycle. That's a long stretch of giving your own hormone system a chance to recover. Get ongoing symptoms checked.",
