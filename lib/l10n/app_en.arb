  "relapseMessage1": "Recovery isn't linear. Every step forward matters, including this one.",
  "@relapseMessage1": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage2": "You're here, you're trying, and that takes real courage.",
  "@relapseMessage2": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage3": "Setbacks don't erase your progress. You're learning and growing.",
  "@relapseMessage3": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage4": "Each restart is proof of your strength, not a sign of weakness.",
  "@relapseMessage4": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage5": "Tomorrow is a fresh start. You've got this.",
  "@relapseMessage5": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage6": "Your worth isn't defined by perfect streaks. You matter.",
  "@relapseMessage6": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage7": "Recovery is a journey with hills and valleys. Keep walking.",
  "@relapseMessage7": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage8": "You had the strength to start before, and you have it again now.",
  "@relapseMessage8": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage9": "One moment doesn't define your entire journey forward.",
  "@relapseMessage9": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage10": "Being here shows you haven't given up. That's powerful.",
  "@relapseMessage10": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage11": "Progress isn't about perfection—it's about persistence.",
  "@relapseMessage11": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage12": "You're building resilience with every attempt. Keep building.",
  "@relapseMessage12": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage13": "Your commitment to trying again is already a victory.",
  "@relapseMessage13": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage14": "Healing isn't instant, but it's happening with each choice you make.",
  "@relapseMessage14": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage15": "You're not starting over—you're continuing with more wisdom.",
  "@relapseMessage15": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage16": "Every expert was once a beginner. Every pro was once an amateur.",
  "@relapseMessage16": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage17": "Recovery happens one day at a time, sometimes one hour at a time.",
  "@relapseMessage17": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage18": "You're writing a comeback story. This is just one chapter.",
  "@relapseMessage18": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage19": "The fact that you're here means you care about yourself. Hold onto that.",
  "@relapseMessage19": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage20": "Small steps in the right direction are still steps forward.",
  "@relapseMessage20": {
    "description": "Encouragement message for relapse"
  },
