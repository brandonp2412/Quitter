    "description": "Encouragement message for relapse"
  },
  "relapseMessage13": "Your commitment to trying again is already a victory.",
  "@relapseMessage13": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage14": "Healing isn't instant, but it's happening with each choice you make.",
