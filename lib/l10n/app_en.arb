  "customMilestone90Title": "Three months clear",
  "@customMilestone90Title": {
    "description": "Custom milestone day 90 title"
  },
  "customMilestone90Description": "Three months. The change has had a chance to meet real life, including the awkward days. You've kept going.",
  "@customMilestone90Description": {
    "description": "Custom milestone day 90 description"
  },
  "customMilestone180Title": "Half a year",
  "@customMilestone180Title": {
    "description": "Custom milestone day 180 title"
