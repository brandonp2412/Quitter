    "description": "Encouragement message for relapse"
  },
  "relapseMessage6": "Your worth isn't defined by perfect streaks. You matter.",
  "@relapseMessage6": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage7": "Recovery is a journey with hills and valleys. Keep walking.",
