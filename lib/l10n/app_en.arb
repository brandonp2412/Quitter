  "customMilestone7Description": "Seven days. You've seen a full week's worth of routines without the habit. That's useful experience to build on.",
  "@customMilestone7Description": {
    "description": "Custom milestone day 7 description"
  },
  "customMilestone14Title": "Two weeks in the bag",
  "@customMilestone14Title": {
    "description": "Custom milestone day 14 title"
  },
  "customMilestone14Description": "Fourteen days. You're learning when the old urge turns up and what actually helps. Keep the useful bits.",
  "@customMilestone14Description": {
    "description": "Custom milestone day 14 description"
  },
  "customMilestone30Title": "One month",
  "@customMilestone30Title": {
    "description": "Custom milestone day 30 title"
  },
  "customMilestone30Description": "Thirty days of doing something differently. That's long enough to notice which routines help and which ones don't.",
