  },
  "marijuanaMilestone365Title": "One year without cannabis",
  "@marijuanaMilestone365Title": {
    "description": "Marijuana milestone day 365 title"
  },
  "marijuanaMilestone365Description": "A whole year. Whatever changed in your memory, motivation or sleep, you've got twelve months of real-world experience without cannabis.",
  "@marijuanaMilestone365Description": {
