  "marijuanaMilestone1Title": "First day without cannabis",
  "@marijuanaMilestone1Title": {
    "description": "Marijuana milestone day 1 title"
  },
  "marijuanaMilestone1Description": "THC withdrawal can bring irritability, anxiety and sleep trouble in the first days. If today feels edgy, there's a reason.",
  "@marijuanaMilestone1Description": {
    "description": "Marijuana milestone day 1 description"
  },
  "marijuanaMilestone3Title": "The rough bit",
  "@marijuanaMilestone3Title": {
    "description": "Marijuana milestone day 3 title"
  },
  "marijuanaMilestone3Description": "Withdrawal often peaks in the first week. Sleep, mood and appetite can be all over the place. Three days without cannabis is a start worth noting.",
  "@marijuanaMilestone3Description": {
    "description": "Marijuana milestone day 3 description"
  },
  "marijuanaMilestone7Title": "A week clear",
  "@marijuanaMilestone7Title": {
    "description": "Marijuana milestone day 7 title"
  },
  "marijuanaMilestone7Description": "Seven days without cannabis. Dreams and sleep can get weird before they improve. You're getting through that adjustment.",
  "@marijuanaMilestone7Description": {
    "description": "Marijuana milestone day 7 description"
  },
  "marijuanaMilestone14Title": "Two weeks without it",
  "@marijuanaMilestone14Title": {
    "description": "Marijuana milestone day 14 title"
  },
  "marijuanaMilestone14Description": "Two weeks clear. Many early withdrawal symptoms ease around this point, though some take longer. Good work getting here.",
  "@marijuanaMilestone14Description": {
    "description": "Marijuana milestone day 14 description"
  },
  "marijuanaMilestone30Title": "A month, less fog",
  "@marijuanaMilestone30Title": {
    "description": "Marijuana milestone day 30 title"
  },
  "marijuanaMilestone30Description": "Thirty days without cannabis. Studies have found improvements in some memory and learning skills after abstinence. Your head may feel clearer.",
  "@marijuanaMilestone30Description": {
    "description": "Marijuana milestone day 30 description"
  },
  "marijuanaMilestone60Title": "Two months, more focus",
  "@marijuanaMilestone60Title": {
    "description": "Marijuana milestone day 60 title"
  },
  "marijuanaMilestone60Description": "Two months clear. Attention and concentration can improve over time away from cannabis. The change isn't identical for everyone.",
  "@marijuanaMilestone60Description": {
    "description": "Marijuana milestone day 60 description"
  },
  "marijuanaMilestone90Title": "Three months",
  "@marijuanaMilestone90Title": {
    "description": "Marijuana milestone day 90 title"
  },
  "marijuanaMilestone90Description": "Three months without cannabis. Sleep, mood and anxiety may be settling, and you've had time to build a routine without it.",
  "@marijuanaMilestone90Description": {
    "description": "Marijuana milestone day 90 description"
  },
  "marijuanaMilestone180Title": "Six months, plenty done",
  "@marijuanaMilestone180Title": {
    "description": "Marijuana milestone day 180 title"
  },
  "marijuanaMilestone180Description": "Half a year. Thinking and everyday decision-making can improve during recovery. Six months of different choices is worth recognising.",
  "@marijuanaMilestone180Description": {
