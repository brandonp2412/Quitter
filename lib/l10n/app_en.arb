  "alcoholMilestone1Title": "First night, no alcohol",
  "@alcoholMilestone1Title": {
    "description": "Alcohol milestone day 1 title"
  },
  "alcoholMilestone1Description": "Alcohol disrupts normal sleep. One night without it removes that effect, though sleep can be rough at first, especially if withdrawal is involved.",
  "@alcoholMilestone1Description": {
    "description": "Alcohol milestone day 1 description"
  },
  "alcoholMilestone3Title": "Three days",
  "@alcoholMilestone3Title": {
    "description": "Alcohol milestone day 3 title"
  },
  "alcoholMilestone3Description": "Three days is a serious early step. Alcohol withdrawal can become dangerous around this time; seizures, hallucinations or severe confusion need urgent medical help.",
  "@alcoholMilestone3Description": {
    "description": "Alcohol milestone day 3 description"
  },
  "alcoholMilestone7Title": "A full week clear",
  "@alcoholMilestone7Title": {
    "description": "Alcohol milestone day 7 title"
  },
  "alcoholMilestone7Description": "Seven days without alcohol. Heavy drinking can weaken immune defences; stopping gives them room to recover.",
  "@alcoholMilestone7Description": {
    "description": "Alcohol milestone day 7 description"
  },
  "alcoholMilestone14Title": "Two weeks, brain included",
  "@alcoholMilestone14Title": {
    "description": "Alcohol milestone day 14 title"
  },
  "alcoholMilestone14Description": "Two weeks alcohol-free. Studies have found early improvements in brain structure and attention during abstinence.",
  "@alcoholMilestone14Description": {
    "description": "Alcohol milestone day 14 description"
  },
  "alcoholMilestone30Title": "A month",
  "@alcoholMilestone30Title": {
    "description": "Alcohol milestone day 30 title"
  },
  "alcoholMilestone30Description": "Thirty days without a drink. Blood pressure can fall after heavy drinking stops, easing one of the strains alcohol puts on your heart.",
  "@alcoholMilestone30Description": {
    "description": "Alcohol milestone day 30 description"
  },
  "alcoholMilestone60Title": "Two months, liver break",
  "@alcoholMilestone60Title": {
    "description": "Alcohol milestone day 60 title"
  },
  "alcoholMilestone60Description": "Two months without alcohol. Fatty liver changes caused by drinking can improve with abstinence, though more serious damage needs medical care.",
  "@alcoholMilestone60Description": {
    "description": "Alcohol milestone day 60 description"
  },
  "alcoholMilestone90Title": "Three months, clearer head",
  "@alcoholMilestone90Title": {
    "description": "Alcohol milestone day 90 title"
  },
  "alcoholMilestone90Description": "Three months alcohol-free. Attention, memory and mental speed can improve in recovery. You've given your head some proper breathing room.",
  "@alcoholMilestone90Description": {
    "description": "Alcohol milestone day 90 description"
  },
  "alcoholMilestone180Title": "Half a year",
  "@alcoholMilestone180Title": {
    "description": "Alcohol milestone day 180 title"
  },
  "alcoholMilestone180Description": "Six months without alcohol. Brain structure and thinking can continue recovering over months. You've put half a year into that process.",
  "@alcoholMilestone180Description": {
    "description": "Alcohol milestone day 180 description"
  },
  "alcoholMilestone365Title": "A year",
  "@alcoholMilestone365Title": {
    "description": "Alcohol milestone day 365 title"
  },
  "alcoholMilestone365Description": "One year without a drink. Alcohol causes several cancers; stopping removes ongoing exposure, and some cancer risks decline with time.",
  "@alcoholMilestone365Description": {
    "description": "Alcohol milestone day 365 description"
  },
  "smokingMilestone1Title": "Carbon monoxide drops",
  "@smokingMilestone1Title": {
    "description": "Smoking milestone day 1 title"
  },
  "smokingMilestone1Description": "Within about a day of your last cigarette, carbon monoxide in your blood falls dramatically. Your body can carry oxygen more effectively.",
  "@smokingMilestone1Description": {
    "description": "Smoking milestone day 1 description"
  },
  "smokingMilestone3Title": "The cravings have opinions",
  "@smokingMilestone3Title": {
    "description": "Smoking milestone day 3 title"
  },
  "smokingMilestone3Description": "Nicotine withdrawal often peaks around the first few days. Cravings can be loud, but they pass. Three days smoke-free is solid work.",
  "@smokingMilestone3Description": {
    "description": "Smoking milestone day 3 description"
  },
  "smokingMilestone7Title": "A week of better senses",
  "@smokingMilestone7Title": {
    "description": "Smoking milestone day 7 title"
  },
  "smokingMilestone7Description": "Seven days without cigarettes. Taste and smell may be coming back as your senses recover. Food might have a few surprises left.",
  "@smokingMilestone7Description": {
    "description": "Smoking milestone day 7 description"
  },
  "smokingMilestone14Title": "Two weeks, more air",
  "@smokingMilestone14Title": {
    "description": "Smoking milestone day 14 title"
  },
  "smokingMilestone14Description": "Two weeks smoke-free. Circulation starts improving after quitting, and moving around may gradually feel easier.",
  "@smokingMilestone14Description": {
    "description": "Smoking milestone day 14 description"
  },
  "smokingMilestone30Title": "A month for your lungs",
  "@smokingMilestone30Title": {
    "description": "Smoking milestone day 30 title"
  },
  "smokingMilestone30Description": "One month without smoke. Lung function and the tiny airway-cleaning hairs can start recovering, though coughs and symptoms may take longer.",
  "@smokingMilestone30Description": {
    "description": "Smoking milestone day 30 description"
  },
  "smokingMilestone90Title": "Three months, building gains",
  "@smokingMilestone90Title": {
    "description": "Smoking milestone day 90 title"
  },
  "smokingMilestone90Description": "Three months clear. Breathing and circulation can keep improving. Your heart's long-term risk is heading in a better direction, too.",
  "@smokingMilestone90Description": {
    "description": "Smoking milestone day 90 description"
  },
  "smokingMilestone180Title": "Six months, lungs at work",
  "@smokingMilestone180Title": {
    "description": "Smoking milestone day 180 title"
  },
  "smokingMilestone180Description": "Six months smoke-free. Research has found recovery in some lung immune-cell responses after months of abstinence.",
  "@smokingMilestone180Description": {
    "description": "Smoking milestone day 180 description"
  },
  "smokingMilestone365Title": "A year without cigarettes",
  "@smokingMilestone365Title": {
    "description": "Smoking milestone day 365 title"
  },
  "smokingMilestone365Description": "A whole year. You've avoided a year of smoke exposure, and heart and blood-vessel risks keep falling after quitting.",
  "@smokingMilestone365Description": {
    "description": "Smoking milestone day 365 description"
  },
  "smokingMilestone730Title": "Two years",
  "@smokingMilestone730Title": {
    "description": "Smoking milestone day 730 title"
  },
  "smokingMilestone730Description": "Two years smoke-free. Heart-attack risk falls sharply in the first one to two years after quitting.",
