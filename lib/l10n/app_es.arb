  "relapseMessage1": "La recuperación no es lineal. Cada paso adelante cuenta, incluido este.",
  "@relapseMessage1": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage2": "Estás aquí, lo estás intentando y eso requiere verdadero valor.",
  "@relapseMessage2": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage3": "Los tropiezos no borran tu progreso. Estás aprendiendo y creciendo.",
  "@relapseMessage3": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage4": "Cada reinicio demuestra tu fortaleza, no tu debilidad.",
  "@relapseMessage4": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage5": "Mañana es un nuevo comienzo. Puedes con esto.",
  "@relapseMessage5": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage6": "Tu valor no lo definen las rachas perfectas. Tú importas.",
  "@relapseMessage6": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage7": "La recuperación es un camino con subidas y bajadas. Sigue avanzando.",
  "@relapseMessage7": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage8": "Tuviste la fuerza para empezar antes y vuelves a tenerla ahora.",
  "@relapseMessage8": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage9": "Un momento no define todo el camino que tienes por delante.",
  "@relapseMessage9": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage10": "Estar aquí demuestra que no te has rendido. Eso tiene mucha fuerza.",
  "@relapseMessage10": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage11": "El progreso no consiste en la perfección, sino en la constancia.",
  "@relapseMessage11": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage12": "Con cada intento estás desarrollando resiliencia. Sigue así.",
  "@relapseMessage12": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage13": "Tu compromiso de volver a intentarlo ya es una victoria.",
  "@relapseMessage13": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage14": "Sanar no es instantáneo, pero ocurre con cada decisión que tomas.",
  "@relapseMessage14": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage15": "No estás empezando de cero: continúas con más experiencia.",
  "@relapseMessage15": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage16": "Todo experto fue alguna vez principiante. Todo profesional fue alguna vez aficionado.",
  "@relapseMessage16": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage17": "La recuperación sucede día a día y, a veces, hora a hora.",
  "@relapseMessage17": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage18": "Estás escribiendo una historia de superación. Este es solo un capítulo.",
  "@relapseMessage18": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage19": "El hecho de estar aquí significa que te importas. Aférrate a eso.",
  "@relapseMessage19": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage20": "Los pasos pequeños en la dirección correcta siguen siendo pasos adelante.",
  "@relapseMessage20": {
    "description": "Encouragement message for relapse"
  },
