  "adderallPageTitle": "Keluar dari Adderall",
  "@adderallPageTitle": {"description": "Title of the adderall recovery page."},
  "adderallHeaderStarted": "Perjalanan Pemulihan Anda",
  "@adderallHeaderStarted": {"description": "Heading shown after adderall tracking starts."},
  "adderallHeaderNotStarted": "Siap Memulai Pemulihan Anda?",
  "@adderallHeaderNotStarted": {"description": "Heading shown before adderall tracking starts."},
  "adderallSubtitleStarted": "Lacak kemajuan Anda dan rayakan setiap pencapaian saat otak Anda pulih",
  "@adderallSubtitleStarted": {"description": "Subtitle shown after adderall tracking starts."},
  "adderallSubtitleNotStarted": "Lihat apa yang terjadi ketika Anda keluar dari Adderall dan memulai perjalanan Anda menuju pemulihan",
  "@adderallSubtitleNotStarted": {"description": "Subtitle shown before adderall tracking starts."},
  "adderallMilestone1Title": "24 Jam Pertama: Gejala Putus Zat Dimulai",
  "@adderallMilestone1Title": {"description": "Title for the adderall recovery milestone at 1 day."},
  "adderallMilestone1Description": "Anda mungkin merasa semakin lelah, depresi, dan nafsu makan saat tubuh Anda mulai menyesuaikan diri dengan kehidupan tanpa stimulan. Ini normal dan bersifat sementara. Tetap terhidrasi dan istirahat bila diperlukan.",
  "@adderallMilestone1Description": {"description": "Description for the adderall recovery milestone at 1 day."},
  "adderallMilestone3Title": "Hari ke-3: Puncak Gejala Putus Zat",
  "@adderallMilestone3Title": {"description": "Title for the adderall recovery milestone at 3 days."},
  "adderallMilestone3Description": "Gejala putus zat mencapai intensitas puncaknya. Anda mungkin mengalami kelelahan yang parah, mudah tersinggung, dan kesulitan berkonsentrasi. Ini adalah bagian tersulit - tetapi mulai sekarang akan menjadi lebih baik. Pertimbangkan untuk menghubungi sistem pendukung Anda.",
  "@adderallMilestone3Description": {"description": "Description for the adderall recovery milestone at 3 days."},
  "adderallMilestone7Title": "Satu Minggu: Gejala Fisik Membaik",
  "@adderallMilestone7Title": {"description": "Title for the adderall recovery milestone at 7 days."},
  "adderallMilestone7Description": "Gejala fisik putus zat yang terburuk mulai memudar. Pola tidur mulai normal dan tingkat energi perlahan membaik. Tubuh Anda beradaptasi untuk berfungsi tanpa stimulan.",
  "@adderallMilestone7Description": {"description": "Description for the adderall recovery milestone at 7 days."},
  "adderallMilestone14Title": "Dua Minggu: Stabilitas Emosional Kembali",
  "@adderallMilestone14Title": {"description": "Title for the adderall recovery milestone at 14 days."},
  "adderallMilestone14Description": "Perubahan suasana hati dan mudah tersinggung berkurang. Anda mendapatkan kembali keseimbangan emosional seiring dengan stabilnya kimia otak Anda. Banyak orang mendapati minggu ini menandai titik balik dalam perjalanan pemulihan mereka.",
  "@adderallMilestone14Description": {"description": "Description for the adderall recovery milestone at 14 days."},
  "adderallMilestone30Title": "Satu Bulan: Penyeimbangan Kembali Kimia Otak",
  "@adderallMilestone30Title": {"description": "Title for the adderall recovery milestone at 30 days."},
  "adderallMilestone30Description": "Otak Anda secara aktif melakukan penyembuhan. Produksi dopamin alami meningkat, dan Anda mungkin merasakan fokus dan motivasi yang lebih baik tanpa pengobatan. Kualitas tidur dan nafsu makan kembali ke pola normal.",
  "@adderallMilestone30Description": {"description": "Description for the adderall recovery milestone at 30 days."},
  "adderallMilestone60Title": "Dua Bulan: Berpikir dan Ingatan Meningkat",
  "@adderallMilestone60Title": {"description": "Title for the adderall recovery milestone at 60 days."},
  "adderallMilestone60Description": "Peningkatan signifikan dalam kejernihan mental, memori, dan stabilitas suasana hati. Sistem penghargaan otak Anda sedang dalam proses penyembuhan, membuat aktivitas sehari-hari menjadi lebih bermanfaat secara alami. Banyak orang melaporkan merasa lebih seperti diri mereka sendiri.",
  "@adderallMilestone60Description": {"description": "Description for the adderall recovery milestone at 60 days."},
  "adderallMilestone90Title": "Tiga Bulan: Tonggak Pemulihan Besar",
  "@adderallMilestone90Title": {"description": "Title for the adderall recovery milestone at 90 days."},
  "adderallMilestone90Description": "Sebagian besar gejala putus zat telah teratasi. Otak Anda telah membuat kemajuan besar dalam penyembuhan. Tingkat energi alami, fokus, dan pengaturan emosi meningkat secara signifikan. Ini merupakan pencapaian besar yang patut dirayakan.",
  "@adderallMilestone90Description": {"description": "Description for the adderall recovery milestone at 90 days."},
  "adderallMilestone180Title": "Enam Bulan: Penyembuhan Otak Berlanjut",
  "@adderallMilestone180Title": {"description": "Title for the adderall recovery milestone at 180 days."},
  "adderallMilestone180Description": "Sinyal dopamin terus pulih. Fokus, ingatan, suasana hati, dan kualitas hidup sehari-hari terus meningkat.",
  "@adderallMilestone180Description": {"description": "Description for the adderall recovery milestone at 180 days."},
  "adderallMilestone365Title": "Satu Tahun: Pemulihan Hampir Selesai",
  "@adderallMilestone365Title": {"description": "Title for the adderall recovery milestone at 365 days."},
  "adderallMilestone365Description": "Sistem dopamin otak Anda sebagian besar telah kembali berfungsi normal. Anda telah membuktikan ketahanan Anda dan membangun kembali hidup Anda tanpa ketergantungan pada stimulan. Pencapaian ini mewakili transformasi menyeluruh - rayakan seberapa jauh kemajuan Anda!",
  "@adderallMilestone365Description": {"description": "Description for the adderall recovery milestone at 365 days."},
  "benzoPageTitle": "Benzodiazepin",
  "@benzoPageTitle": {"description": "Title of the benzo recovery page."},
  "benzoHeaderStarted": "Perjalanan Pemulihan Anda",
  "@benzoHeaderStarted": {"description": "Heading shown after benzo tracking starts."},
  "benzoHeaderNotStarted": "Manfaat Berhenti dari Benzodiazepin",
  "@benzoHeaderNotStarted": {"description": "Heading shown before benzo tracking starts."},
  "benzoSubtitleStarted": "Lacak kemajuan Anda dan rayakan setiap pencapaian",
  "@benzoSubtitleStarted": {"description": "Subtitle shown after benzo tracking starts."},
  "benzoSubtitleNotStarted": "Lihat apa yang terjadi ketika Anda berhenti",
  "@benzoSubtitleNotStarted": {"description": "Subtitle shown before benzo tracking starts."},
  "benzoMilestone7Title": "Minggu Pertama: Jendela Awal Lengkap",
  "@benzoMilestone7Title": {"description": "Title for the benzo recovery milestone at 7 days."},
  "benzoMilestone7Description": "Pada hari ke-7, seluruh jendela awal yang umum sudah tercakup: putus benzodiazepin kerja singkat biasanya mulai 1–2 hari setelah dosis terakhir, sedangkan yang kerja panjang 2–7 hari. Penurunan dosis bertahap penting karena membantu mencegah kejang.",
  "@benzoMilestone7Description": {"description": "Description for the benzo recovery milestone at 7 days."},
  "benzoMilestone14Title": "Dua Minggu: Tidur Nyenyak Pulih",
  "@benzoMilestone14Title": {"description": "Title for the benzo recovery milestone at 14 days."},
  "benzoMilestone14Description": "Sekitar dua minggu setelah penghentian benzodiazepin secara bertahap, sebuah studi tidur klinis menemukan peningkatan tidur gelombang lambat dan kualitas tidur yang dirasakan. Ini adalah tanda pemulihan awal yang nyata pada sistem tidur.",
  "@benzoMilestone14Description": {"description": "Description for the benzo recovery milestone at 14 days."},
  "benzoMilestone60Title": "8 Minggu: Fokus dan Keseimbangan",
  "@benzoMilestone60Title": {"description": "Title for the benzo recovery milestone at 60 days."},
  "benzoMilestone60Description": "Dalam studi 8 minggu pada pengguna lama obat tidur benzodiazepin yang lebih tua, peserta yang menyelesaikan penurunan dosis hingga berhenti menunjukkan peningkatan pada memori langsung, perhatian, skor bahasa, dan kestabilan tubuh. Ini pemulihan fungsi siang hari yang terukur.",
  "@benzoMilestone60Description": {"description": "Description for the benzo recovery milestone at 60 days."},
  "benzoMilestone90Title": "Tiga Bulan: Pikiran Lebih Cepat",
  "@benzoMilestone90Title": {"description": "Title for the benzo recovery milestone at 90 days."},
  "benzoMilestone90Description": "Pada 12 minggu setelah taper selesai, pengguna benzodiazepin jangka panjang yang berhasil berhenti menyelesaikan tugas kognitif berkecepatan lebih cepat dan melaporkan sedasi mental serta fisik yang lebih ringan dibanding orang yang masih memakai benzodiazepin. Itu adalah pemulihan fungsi siang hari yang terukur.",
  "@benzoMilestone90Description": {"description": "Description for the benzo recovery milestone at 90 days."},
  "benzoMilestone180Title": "Pemikiran dan Ingatan Mulai Pulih",
  "@benzoMilestone180Title": {"description": "Title for the benzo recovery milestone at 180 days."},
  "benzoMilestone180Description": "Pada enam bulan, ingatan dan perhatian menunjukkan peningkatan yang terukur. Penelitian menemukan pemulihan pada banyak keterampilan berpikir, dan kemajuan terus berlanjut setelah enam bulan.",
  "@benzoMilestone180Description": {"description": "Description for the benzo recovery milestone at 180 days."},
  "benzoMilestone365Title": "Satu Tahun Penyembuhan",
  "@benzoMilestone365Title": {"description": "Title for the benzo recovery milestone at 365 days."},
  "benzoMilestone365Description": "Setelah satu tahun, peningkatan signifikan dalam kesejahteraan mental dan fisik mulai terlihat. Banyak yang melaporkan berkurangnya kecemasan, kualitas tidur lebih baik, dan peningkatan kesehatan secara keseluruhan dibandingkan dengan penggunaan benzodiazepin dalam jangka panjang. Penyembuhan otak berlanjut.",
  "@benzoMilestone365Description": {"description": "Description for the benzo recovery milestone at 365 days."},
  "benzoMilestone540Title": "Pemulihan Otak Berkelanjutan",
  "@benzoMilestone540Title": {"description": "Title for the benzo recovery milestone at 540 days."},
  "benzoMilestone540Description": "Pada usia 18 bulan, ingatan, perhatian, dan pemikiran jernih terus meningkat. Sistem GABA yang menenangkan di otak membutuhkan waktu lebih dari satu tahun untuk menetap, sementara otak terus membangun pola yang lebih sehat.",
  "@benzoMilestone540Description": {"description": "Description for the benzo recovery milestone at 540 days."},
  "benzoMilestone730Title": "Dua Tahun: Kemajuan Besar",
  "@benzoMilestone730Title": {"description": "Title for the benzo recovery milestone at 730 days."},
  "benzoMilestone730Description": "Dua tahun menandai pemulihan substansial. Kebanyakan orang memiliki pemikiran yang lebih jernih, emosi yang lebih stabil, dan kualitas hidup yang jauh lebih baik dibandingkan dengan penggunaan benzodiazepin jangka panjang.",
  "@benzoMilestone730Description": {"description": "Description for the benzo recovery milestone at 730 days."},
  "benzoMilestone1095Title": "Tiga Tahun: Pemulihan Jangka Panjang",
  "@benzoMilestone1095Title": {"description": "Title for the benzo recovery milestone at 1095 days."},
  "benzoMilestone1095Description": "Dalam tiga tahun, periode penarikan yang lama jauh tertinggal dari kebanyakan orang. Tidur, suasana hati, ingatan, dan perhatian membutuhkan waktu bertahun-tahun untuk pulih, dan kehidupan sehari-hari biasanya jauh lebih baik dibandingkan penggunaan jangka panjang.",
  "@benzoMilestone1095Description": {"description": "Description for the benzo recovery milestone at 1095 days."},
  "benzoMilestone1460Title": "Empat Tahun: Kemajuan Mantap",
  "@benzoMilestone1460Title": {"description": "Title for the benzo recovery milestone at 1460 days."},
  "benzoMilestone1460Description": "Empat tahun tanpa benzodiazepin adalah perjalanan pemulihan panjang yang dibangun hari demi hari. Karena waktunya berbeda untuk setiap orang, peringatan ini merayakan kestabilan, rutinitas, dan ketangguhan yang telah diperkuat tanpa menganggap ada satu garis akhir bagi semua orang.",
  "@benzoMilestone1460Description": {"description": "Description for the benzo recovery milestone at 1460 days."},
  "benzoMilestone1825Title": "Lima Tahun: Fondasi Kuat",
  "@benzoMilestone1825Title": {"description": "Title for the benzo recovery milestone at 1825 days."},
  "benzoMilestone1825Description": "Lima tahun adalah pencapaian jangka panjang yang besar. Pemulihan tidak mengikuti satu jadwal, tetapi lima tahun perubahan yang bertahan berarti ribuan hari latihan, dukungan, dan kehidupan yang dibangun melampaui benzodiazepin.",
  "@benzoMilestone1825Description": {"description": "Description for the benzo recovery milestone at 1825 days."},
  "addictionMeth": "Met",
  "@addictionMeth": {"description": "Name of the meth addiction category."},
