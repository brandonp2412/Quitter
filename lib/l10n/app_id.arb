  "ketamineSubtitleStarted": "Lacak kemajuan Anda dan rayakan setiap pencapaian",
  "@ketamineSubtitleStarted": {"description": "Subtitle shown after ketamine tracking starts."},
  "ketamineSubtitleNotStarted": "Lihat apa yang terjadi ketika Anda berhenti",
  "@ketamineSubtitleNotStarted": {"description": "Subtitle shown before ketamine tracking starts."},
  "ketamineInfoBox": "Penarikan ketamin terutama disebabkan oleh rasa lapar, suasana hati yang buruk, dan kabut otak, bukan karena penyakit fisik. Kerugian fisik terbesarnya adalah kerusakan kandung kemih, dan berhenti merokok adalah langkah penting pertama menuju pemulihan.",
  "@ketamineInfoBox": {"description": "Recovery information shown on the ketamine page."},
  "addictionKetamine": "Ketamin",
  "@addictionKetamine": {"description": "Name of the ketamine addiction category."},
  "ketamineMilestone1Title": "Ketamin Mulai Keluar",
  "@ketamineMilestone1Title": {"description": "Title for the ketamine recovery milestone at 1 day."},
  "ketamineMilestone1Description": "Ketamin jarang menyebabkan gejala putus zat fisik yang berat. Pada hari pertama, perubahan suasana hati, keinginan memakai, berkeringat, atau jantung berdebar dapat muncul saat obat keluar dari tubuh.",
  "@ketamineMilestone1Description": {"description": "Description for the ketamine recovery milestone at 1 day."},
  "ketamineMilestone7Title": "Suasana Hati dan Keinginan",
  "@ketamineMilestone7Title": {"description": "Title for the ketamine recovery milestone at 7 days."},
  "ketamineMilestone7Description": "Minggu pertama lebih banyak ditandai keinginan memakai, suasana hati rendah atau berubah-ubah, dan kabut otak daripada gejala putus zat fisik.",
  "@ketamineMilestone7Description": {"description": "Description for the ketamine recovery milestone at 7 days."},
  "ketamineMilestone14Title": "Kabut Otak Mulai Hilang",
  "@ketamineMilestone14Title": {"description": "Title for the ketamine recovery milestone at 14 days."},
  "ketamineMilestone14Description": "Dua minggu kemudian, pemikiran dan ingatan mulai jernih dan suasana hati menjadi stabil seiring dengan hilangnya efek disosiatif sepenuhnya.",
  "@ketamineMilestone14Description": {"description": "Description for the ketamine recovery milestone at 14 days."},
  "ketamineMilestone30Title": "Satu Bulan — Kandung Kemih Pulih",
  "@ketamineMilestone30Title": {"description": "Title for the ketamine recovery milestone at 30 days."},
  "ketamineMilestone30Description": "Dalam sebulan, kerusakan kandung kemih dini sering kali mulai membaik setelah Anda berhenti. Suasana hati dan pemikiran lebih jernih.",
  "@ketamineMilestone30Description": {"description": "Description for the ketamine recovery milestone at 30 days."},
  "ketamineMilestone90Title": "Tiga Bulan Tanpa Ketamin",
  "@ketamineMilestone90Title": {"description": "Title for the ketamine recovery milestone at 90 days."},
  "ketamineMilestone90Description": "Tiga bulan tanpa ketamin memberi kandung kemih lebih banyak waktu untuk pulih, sementara pemikiran dan suasana hati terus membaik. Mengidam lebih jarang terjadi.",
  "@ketamineMilestone90Description": {"description": "Description for the ketamine recovery milestone at 90 days."},
  "ketamineMilestone180Title": "Enam Bulan Bebas Ketamin",
  "@ketamineMilestone180Title": {"description": "Title for the ketamine recovery milestone at 180 days."},
  "ketamineMilestone180Description": "Enam bulan tanpa ketamin. Gejala kandung kemih telah memiliki waktu lebih lama untuk membaik, dan dorongan psikologis untuk memakai ketamin jauh berkurang.",
  "@ketamineMilestone180Description": {"description": "Description for the ketamine recovery milestone at 180 days."},
  "ketamineMilestone365Title": "Satu Tahun Bebas Ketamin",
  "@ketamineMilestone365Title": {"description": "Title for the ketamine recovery milestone at 365 days."},
  "ketamineMilestone365Description": "Satu tahun tanpa ketamin. Pikiran, suasana hati, dan — bila kerusakan kandung kemih ditemukan sejak dini — fungsi kandung kemih telah memiliki satu tahun penuh untuk pulih.",
  "@ketamineMilestone365Description": {"description": "Description for the ketamine recovery milestone at 365 days."},
  "ketamineMilestone730Title": "Dua Tahun: Dasar Lebih Kokoh",
  "@ketamineMilestone730Title": {"description": "Title for the ketamine recovery milestone at 730 days."},
  "ketamineMilestone730Description": "Dua tahun tanpa ketamin adalah kemajuan yang berkelanjutan. Tetap berhenti mencegah paparan kembali, sementara pemulihan setelah penggunaan sebelumnya dapat berbeda pada setiap orang.",
  "@ketamineMilestone730Description": {"description": "Description for the ketamine recovery milestone at 730 days."},
  "ketamineMilestone1095Title": "Tiga Tahun: Momentum Terbangun",
  "@ketamineMilestone1095Title": {"description": "Title for the ketamine recovery milestone at 1095 days."},
  "ketamineMilestone1095Description": "Tiga tahun menandai kemajuan yang bertahan. Riset mendukung adanya perbaikan setelah berhenti dari ketamin, tetapi tidak menetapkan titik biologis khusus pada tahun ketiga.",
  "@ketamineMilestone1095Description": {"description": "Description for the ketamine recovery milestone at 1095 days."},
  "ketamineMilestone1460Title": "Empat Tahun: Kekuatan Stabil",
  "@ketamineMilestone1460Title": {"description": "Title for the ketamine recovery milestone at 1460 days."},
  "ketamineMilestone1460Description": "Empat tahun menambah satu tahun lagi jauh dari ketamin. Pemulihan jangka panjang dapat terus berlangsung, dengan hasil yang dipengaruhi paparan sebelumnya dan cedera yang ada.",
  "@ketamineMilestone1460Description": {"description": "Description for the ketamine recovery milestone at 1460 days."},
  "ketamineMilestone1825Title": "Lima Tahun: Akar yang Dalam",
  "@ketamineMilestone1825Title": {"description": "Title for the ketamine recovery milestone at 1825 days."},
  "ketamineMilestone1825Description": "Lima tahun adalah tonggak besar yang berkelanjutan. Menjaga rutinitas dan dukungan yang membantu kemajuan ini ikut mempertahankan fondasi yang kuat.",
  "@ketamineMilestone1825Description": {"description": "Description for the ketamine recovery milestone at 1825 days."},
  "inhalantsPageTitle": "Inhalansia",
  "@inhalantsPageTitle": {"description": "Title of the inhalants recovery page."},
  "inhalantsHeaderStarted": "Perjalanan Pemulihan Anda",
  "@inhalantsHeaderStarted": {"description": "Heading shown after inhalants tracking starts."},
  "inhalantsHeaderNotStarted": "Manfaat Berhenti Menghirup Inhalansia",
  "@inhalantsHeaderNotStarted": {"description": "Heading shown before inhalants tracking starts."},
  "inhalantsSubtitleStarted": "Lacak kemajuan Anda dan rayakan setiap pencapaian",
  "@inhalantsSubtitleStarted": {"description": "Subtitle shown after inhalants tracking starts."},
  "inhalantsSubtitleNotStarted": "Lihat apa yang terjadi ketika Anda berhenti",
  "@inhalantsSubtitleNotStarted": {"description": "Subtitle shown before inhalants tracking starts."},
  "inhalantsInfoBox": "Gejala putus zat melalui inhalasi lebih singkat dibandingkan alkohol atau opioid, namun efeknya bisa sangat intens, dengan risiko kejang pada pengguna berat. Pemulihan neurologis memang nyata namun lambat – sering kali terjadi setelah dua tahun berpantang.",
  "@inhalantsInfoBox": {"description": "Recovery information shown on the inhalants page."},
  "addictionInhalants": "Inhalansia",
  "@addictionInhalants": {"description": "Name of the inhalants addiction category."},
  "inhalantsMilestone1Title": "Tubuh Mulai Membersihkan Zat",
  "@inhalantsMilestone1Title": {"description": "Title for the inhalants recovery milestone at 1 day."},
  "inhalantsMilestone1Description": "Zat kimia inhalansia cepat keluar dari aliran darah, tetapi dapat bertahan di jaringan lemak. Pada hari pertama, Anda mungkin mengalami sakit kepala, mudah tersinggung, mual, cemas, atau sulit tidur.",
  "@inhalantsMilestone1Description": {"description": "Description for the inhalants recovery milestone at 1 day."},
  "inhalantsMilestone7Title": "Gejala Akut Mulai Mereda",
  "@inhalantsMilestone7Title": {"description": "Title for the inhalants recovery milestone at 7 days."},
  "inhalantsMilestone7Description": "Gejala putus zat akut biasanya memuncak sekitar hari ke-2 hingga ke-5 dan sebagian besar mereda dalam satu sampai dua minggu. Setelah seminggu, fase terburuk biasanya mulai terlewati.",
  "@inhalantsMilestone7Description": {"description": "Description for the inhalants recovery milestone at 7 days."},
  "inhalantsMilestone14Title": "Fase Akut Terlewati",
  "@inhalantsMilestone14Title": {"description": "Title for the inhalants recovery milestone at 14 days."},
  "inhalantsMilestone14Description": "Dalam dua minggu, fase awal putus zat biasanya sudah berakhir. Suasana hati lebih stabil, meski kabut otak dan kelelahan masih dapat bertahan.",
  "@inhalantsMilestone14Description": {"description": "Description for the inhalants recovery milestone at 14 days."},
  "inhalantsMilestone30Title": "Satu Bulan — Otak Terus Pulih",
  "@inhalantsMilestone30Title": {"description": "Title for the inhalants recovery milestone at 30 days."},
  "inhalantsMilestone30Description": "Setelah satu bulan, efek awal yang paling berat sudah terlewati dan kemampuan berpikir serta ingatan mulai pulih. Kejernihan pikiran dan suasana hati membaik.",
  "@inhalantsMilestone30Description": {"description": "Description for the inhalants recovery milestone at 30 days."},
  "inhalantsMilestone90Title": "Tiga Bulan — Pemulihan Berlanjut",
  "@inhalantsMilestone90Title": {"description": "Title for the inhalants recovery milestone at 90 days."},
  "inhalantsMilestone90Description": "Tiga bulan tanpa inhalansia mendukung pemulihan berkelanjutan pada ingatan, perhatian, dan fungsi motorik. Perbaikannya bertahap, tetapi nyata.",
  "@inhalantsMilestone90Description": {"description": "Description for the inhalants recovery milestone at 90 days."},
  "inhalantsMilestone365Title": "Satu Tahun — Pemulihan Besar",
  "@inhalantsMilestone365Title": {"description": "Title for the inhalants recovery milestone at 365 days."},
  "inhalantsMilestone365Description": "Satu tahun tanpa inhalansia membawa pemulihan neurologis yang besar bagi kebanyakan orang, dengan kemajuan yang diperkirakan terus berlanjut pada tahun kedua.",
  "@inhalantsMilestone365Description": {"description": "Description for the inhalants recovery milestone at 365 days."},
  "inhalantsMilestone730Title": "Dua Tahun — Pemulihan Jangka Panjang",
  "@inhalantsMilestone730Title": {"description": "Title for the inhalants recovery milestone at 730 days."},
  "inhalantsMilestone730Description": "Setelah dua tahun abstinensi, penelitian menemukan pemulihan besar pada fungsi otak. Kerusakan akibat bensin bertimbal merupakan pengecualian dan dapat menetap.",
  "@inhalantsMilestone730Description": {"description": "Description for the inhalants recovery milestone at 730 days."},
