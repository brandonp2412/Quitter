    "description": "Encouragement message for relapse"
  },
  "relapseMessage15": "Anda tidak memulai dari awal—Anda melanjutkan dengan lebih banyak kebijaksanaan.",
  "@relapseMessage15": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage16": "Setiap ahli pernah menjadi pemula. Setiap profesional pernah menjadi amatir.",
  "@relapseMessage16": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage17": "Pemulihan terjadi setiap hari, terkadang satu jam pada suatu waktu.",
  "@relapseMessage17": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage18": "Anda sedang menulis cerita comeback. Ini hanya satu bab.",
  "@relapseMessage18": {
