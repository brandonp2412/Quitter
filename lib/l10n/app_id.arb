  "gabapentinoidsSubtitleStarted": "Lacak kemajuan Anda dan rayakan setiap pencapaian",
  "@gabapentinoidsSubtitleStarted": {"description": "Subtitle shown after gabapentinoids tracking starts."},
  "gabapentinoidsSubtitleNotStarted": "Lihat apa yang terjadi ketika Anda berhenti",
  "@gabapentinoidsSubtitleNotStarted": {"description": "Subtitle shown before gabapentinoids tracking starts."},
  "gabapentinoidsInfoBox": "Jangan pernah menghentikan gabapentin atau pregabalin secara tiba-tiba. Penghentian obat secara tiba-tiba dapat memicu kejang - terutama jika Anda meminumnya untuk epilepsi. Pengurangan bertahap yang diawasi secara medis sangat penting.",
  "@gabapentinoidsInfoBox": {"description": "Recovery information shown on the gabapentinoids page."},
  "addictionGabapentinoid": "Obat gabapentinoid",
