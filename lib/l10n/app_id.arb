  "cocaineMilestone1Title": "24 Jam Pertama: Awal Perjalanan",
  "@cocaineMilestone1Title": {"description": "Title for the cocaine recovery milestone at 1 day."},
  "cocaineMilestone1Description": "Tubuh Anda mulai menyesuaikan diri saat kadar dopamin mulai stabil. Anda mungkin mengalami kelelahan, perubahan suasana hati, dan keinginan kuat untuk menggunakan kokain, tetapi sistem kardiovaskular Anda sudah mulai pulih.",
  "@cocaineMilestone1Description": {"description": "Description for the cocaine recovery milestone at 1 day."},
  "cocaineMilestone3Title": "Hari ke-3: Tantangan Terberat",
  "@cocaineMilestone3Title": {"description": "Title for the cocaine recovery milestone at 3 days."},
  "cocaineMilestone3Description": "Gejala putus zat sering memuncak sekitar waktu ini. Keinginan kuat untuk menggunakan, mudah tersinggung, cemas, dan kelelahan dapat muncul. Ini bersifat sementara; otak Anda sedang bekerja untuk menyeimbangkan diri kembali.",
  "@cocaineMilestone3Description": {"description": "Description for the cocaine recovery milestone at 3 days."},
  "cocaineMilestone7Title": "Satu Minggu: Pemulihan Fisik",
  "@cocaineMilestone7Title": {"description": "Title for the cocaine recovery milestone at 7 days."},
  "cocaineMilestone7Description": "Gejala fisik yang paling berat mulai mereda. Detak jantung dan tekanan darah mulai stabil. Keinginan psikologis mungkin masih muncul, sementara tubuh Anda terus pulih.",
  "@cocaineMilestone7Description": {"description": "Description for the cocaine recovery milestone at 7 days."},
  "cocaineMilestone14Title": "Dua Minggu: Mulai Stabil",
  "@cocaineMilestone14Title": {"description": "Title for the cocaine recovery milestone at 14 days."},
  "cocaineMilestone14Description": "Banyak orang mulai merasa lebih stabil secara emosional. Tingkat energi membaik dan gejala putus zat akut mulai mereda. Kesehatan kardiovaskular juga terus membaik.",
  "@cocaineMilestone14Description": {"description": "Description for the cocaine recovery milestone at 14 days."},
  "cocaineMilestone60Title": "Dua Bulan: Tidur dan Suasana Hati",
  "@cocaineMilestone60Title": {"description": "Title for the cocaine recovery milestone at 60 days."},
  "cocaineMilestone60Description": "Kualitas tidur terasa lebih baik saat kimia otak terus menuju kondisi normal. Anda mungkin merasa lebih segar dan mengalami suasana hati yang lebih stabil sepanjang hari.",
  "@cocaineMilestone60Description": {"description": "Description for the cocaine recovery milestone at 60 days."},
  "cocaineMilestone90Title": "Tiga Bulan: Pemulihan Otak",
  "@cocaineMilestone90Title": {"description": "Title for the cocaine recovery milestone at 90 days."},
  "cocaineMilestone90Description": "Sistem dopamin Anda sedang pulih. Fokus, pengambilan keputusan, dan pengaturan emosi membaik secara nyata, dan pikiran menjadi lebih jernih.",
  "@cocaineMilestone90Description": {"description": "Description for the cocaine recovery milestone at 90 days."},
  "cocaineMilestone180Title": "Enam Bulan: Pikiran Lebih Jernih",
  "@cocaineMilestone180Title": {"description": "Title for the cocaine recovery milestone at 180 days."},
  "cocaineMilestone180Description": "Pemindaian otak menunjukkan pemulihan di bagian depan otak, area yang mendukung perencanaan dan pengendalian diri. Memori, kendali impuls, dan kejernihan berpikir terus menguat.",
  "@cocaineMilestone180Description": {"description": "Description for the cocaine recovery milestone at 180 days."},
  "cocaineMilestone365Title": "Satu Tahun: Kesehatan Jantung",
  "@cocaineMilestone365Title": {"description": "Title for the cocaine recovery milestone at 365 days."},
  "cocaineMilestone365Description": "Jantung dan sistem kardiovaskular Anda telah mengalami pemulihan yang berarti. Tekanan darah dan detak jantung telah kembali normal. Risiko serangan jantung dan stroke telah turun secara signifikan. Tubuh Anda terus pulih.",
  "@cocaineMilestone365Description": {"description": "Description for the cocaine recovery milestone at 365 days."},
  "cocaineMilestone730Title": "Dua Tahun - Pemulihan Berkelanjutan",
  "@cocaineMilestone730Title": {"description": "Title for the cocaine recovery milestone at 730 days."},
  "cocaineMilestone730Description": "Penyembuhan otak berlanjut dengan peningkatan berkelanjutan dalam memori, fokus, dan regulasi emosional. Jalur saraf Anda telah ditata ulang secara signifikan, mendukung pola yang lebih sehat dan kesejahteraan yang lebih baik secara keseluruhan.",
  "@cocaineMilestone730Description": {"description": "Description for the cocaine recovery milestone at 730 days."},
  "cocaineMilestone1095Title": "Tiga Tahun: Fondasi Kuat",
  "@cocaineMilestone1095Title": {"description": "Title for the cocaine recovery milestone at 1095 days."},
  "cocaineMilestone1095Description": "Tiga tahun bebas kokain adalah kemajuan yang bertahan. Rutinitas, hubungan, dan keterampilan menghadapi masalah yang kamu bangun telah menguat selama bertahun-tahun dan menjadi fondasi pemulihan.",
  "@cocaineMilestone1095Description": {"description": "Description for the cocaine recovery milestone at 1095 days."},
  "cocaineMilestone1460Title": "Empat Tahun: Momentum Bertahan",
  "@cocaineMilestone1460Title": {"description": "Title for the cocaine recovery milestone at 1460 days."},
  "cocaineMilestone1460Description": "Empat tahun menunjukkan momentum yang bertahan. Satu tahun lagi menjalani hidup tanpa kokain telah memperkuat kebiasaan dan dukungan yang menjaga pemulihan tetap kokoh.",
  "@cocaineMilestone1460Description": {"description": "Description for the cocaine recovery milestone at 1460 days."},
  "cocaineMilestone1825Title": "Lima Tahun: Perubahan Mengakar",
  "@cocaineMilestone1825Title": {"description": "Title for the cocaine recovery milestone at 1825 days."},
