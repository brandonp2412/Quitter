  "methPageTitle": "Pemulihan Sabu",
  "@methPageTitle": {"description": "Title of the meth recovery page."},
  "methHeaderStarted": "Perjalanan Pemulihan Anda",
  "@methHeaderStarted": {"description": "Heading shown after meth tracking starts."},
  "methHeaderNotStarted": "Jatuhkan Gelasnya",
  "@methHeaderNotStarted": {"description": "Heading shown before meth tracking starts."},
  "methSubtitleStarted": "Lacak kemajuan Anda dan rayakan setiap pencapaian",
  "@methSubtitleStarted": {"description": "Subtitle shown after meth tracking starts."},
  "methSubtitleNotStarted": "Kebebasan ada dalam genggaman Anda",
  "@methSubtitleNotStarted": {"description": "Subtitle shown before meth tracking starts."},
  "methMilestone1Title": "24 Jam Pertama — Fase Crash Dimulai",
  "@methMilestone1Title": {"description": "Title for the meth recovery milestone at 1 day."},
  "methMilestone1Description": "Fase crash awal dimulai dengan kelelahan berat dan nafsu makan meningkat saat tubuh mulai pulih. Anda mungkin merasa depresi dan tidur jauh lebih banyak ketika tubuh mulai menstabilkan diri setelah stimulasi yang intens.",
  "@methMilestone1Description": {"description": "Description for the meth recovery milestone at 1 day."},
  "methMilestone3Title": "Hari ke-3 — Puncak Putus Zat",
  "@methMilestone3Title": {"description": "Title for the meth recovery milestone at 3 days."},
  "methMilestone3Description": "Keinginan untuk memakai meningkat kuat selama fase ini saat tubuh menyesuaikan diri. Energi dapat mulai naik dibanding fase crash, sehingga dorongan untuk memakai terasa lebih kuat. Ini masa penting untuk pencegahan kekambuhan dan dukungan.",
  "@methMilestone3Description": {"description": "Description for the meth recovery milestone at 3 days."},
  "methMilestone7Title": "Satu Minggu — Gejala Fisik Mereda",
  "@methMilestone7Title": {"description": "Title for the meth recovery milestone at 7 days."},
  "methMilestone7Description": "Gejala putus zat akut mulai mereda, meski tantangan psikologis masih ada. Pola tidur mulai kembali normal dan ketidaknyamanan fisik berkurang. Ini menandai peralihan dari fase putus zat akut ke fase pasca-akut.",
  "@methMilestone7Description": {"description": "Description for the meth recovery milestone at 7 days."},
  "methMilestone30Title": "Satu Bulan — Mulai Stabil",
  "@methMilestone30Title": {"description": "Title for the meth recovery milestone at 30 days."},
  "methMilestone30Description": "Tubuh terus pulih dan keinginan untuk memakai mulai berkurang. Energi meningkat dan suasana hati membaik seiring kimia otak mulai menyeimbangkan diri kembali. Tetap waspada karena tantangan masih bisa muncul.",
  "@methMilestone30Description": {"description": "Description for the meth recovery milestone at 30 days."},
  "methMilestone90Title": "Tiga Bulan — Otak Mulai Pulih",
  "@methMilestone90Title": {"description": "Title for the meth recovery milestone at 90 days."},
  "methMilestone90Description": "Otak Anda sedang aktif pulih. Perhatian, ingatan, dan pengambilan keputusan mulai membaik seiring sistem penghargaan bergerak menuju kondisi yang lebih normal.",
  "@methMilestone90Description": {"description": "Description for the meth recovery milestone at 90 days."},
  "methMilestone180Title": "Enam Bulan — Pemulihan Jantung",
  "@methMilestone180Title": {"description": "Title for the meth recovery milestone at 180 days."},
  "methMilestone180Description": "Fungsi jantung dapat menunjukkan perbaikan terukur setelah berhenti memakai metamfetamin. Studi menunjukkan fungsi jantung dapat membaik secara bermakna selama masa ini, terutama dengan dukungan medis. Tekanan darah dan irama jantung terus menjadi lebih stabil.",
  "@methMilestone180Description": {"description": "Description for the meth recovery milestone at 180 days."},
  "methMilestone365Title": "Satu Tahun — Pemulihan Otak Besar",
  "@methMilestone365Title": {"description": "Title for the meth recovery milestone at 365 days."},
  "methMilestone365Description": "Setelah satu tahun, sistem dopamin telah mengalami banyak pemulihan. Aktivitas sehari-hari kembali terasa lebih memuaskan, sementara suasana hati, ingatan, dan pengambilan keputusan jauh lebih baik.",
  "@methMilestone365Description": {"description": "Description for the meth recovery milestone at 365 days."},
  "methMilestone420Title": "14 Bulan — Sistem Dopamin Pulih",
  "@methMilestone420Title": {"description": "Title for the meth recovery milestone at 420 days."},
  "methMilestone420Description": "Pemindaian otak menunjukkan protein yang mendaur ulang dopamin mendekati kadar pada orang sehat di sekitar tahap ini. Ingatan, motivasi, dan kemampuan menikmati kegiatan sehari-hari terus membaik.",
  "@methMilestone420Description": {"description": "Description for the meth recovery milestone at 420 days."},
  "methMilestone730Title": "Dua Tahun — Pemulihan Berlanjut",
  "@methMilestone730Title": {"description": "Title for the meth recovery milestone at 730 days."},
  "methMilestone730Description": "Dua tahun tanpa metamfetamin memberi otak waktu panjang untuk terus pulih. Perhatian, suasana hati, ingatan, dan kualitas hidup sehari-hari dapat terus membaik.",
  "@methMilestone730Description": {"description": "Description for the meth recovery milestone at 730 days."},
  "addictionNitrousOxide": "Nitrous Oksida",
  "@addictionNitrousOxide": {"description": "Name of the nitrous oxide addiction category."},
  "nitrousOxidePageTitle": "Nitrous Oksida",
  "@nitrousOxidePageTitle": {"description": "Title of the nitrous oxide recovery page."},
  "nitrousOxideHeaderStarted": "Perjalanan Pemulihan Anda",
  "@nitrousOxideHeaderStarted": {"description": "Heading shown after nitrous oxide tracking starts."},
  "nitrousOxideHeaderNotStarted": "Siap Memulai?",
  "@nitrousOxideHeaderNotStarted": {"description": "Heading shown before nitrous oxide tracking starts."},
  "nitrousOxideSubtitleStarted": "Lacak kemajuan Anda dan rayakan setiap pencapaian",
  "@nitrousOxideSubtitleStarted": {"description": "Subtitle shown after nitrous oxide tracking starts."},
  "nitrousOxideSubtitleNotStarted": "Lihat perubahan positif apa yang menanti Anda",
  "@nitrousOxideSubtitleNotStarted": {"description": "Subtitle shown before nitrous oxide tracking starts."},
  "nitrousOxideMilestone1Title": "24 Jam Pertama – Gas Keluar",
  "@nitrousOxideMilestone1Title": {"description": "Title for the nitrous oxide recovery milestone at 1 day."},
  "nitrousOxideMilestone1Description": "Gas meninggalkan sistem Anda dalam beberapa menit, namun penyembuhan membutuhkan waktu lebih lama. Pusing mereda, sakit kepala mereda, dan otak Anda mulai menyesuaikan diri tanpa jalur pintas dopamin. Pemulihan B12 Anda dimulai sekarang.",
  "@nitrousOxideMilestone1Description": {"description": "Description for the nitrous oxide recovery milestone at 1 day."},
  "nitrousOxideMilestone3Title": "Hari 3 – Tanpa Putus Zat Fisik",
  "@nitrousOxideMilestone3Title": {"description": "Title for the nitrous oxide recovery milestone at 3 days."},
  "nitrousOxideMilestone3Description": "Kabar baiknya: dinitrogen oksida tidak menyebabkan putus zat fisik. Dorongan yang Anda rasakan bersifat psikologis – kebiasaan dan asosiasi, bukan tubuh yang menuntut zat tersebut. Karena itu dorongan ini dapat dikelola.",
  "@nitrousOxideMilestone3Description": {"description": "Description for the nitrous oxide recovery milestone at 3 days."},
  "nitrousOxideMilestone7Title": "Satu Minggu – B12 Mulai Naik",
  "@nitrousOxideMilestone7Title": {"description": "Title for the nitrous oxide recovery milestone at 7 days."},
  "nitrousOxideMilestone7Description": "Satu minggu tanpa ada B12 baru yang dimusnahkan. Jika Anda sudah mulai mengonsumsi suplemen, level Anda sudah meningkat. Energi, suasana hati, dan fokus semuanya terkait dengan B12 — Anda akan mulai merasakannya meningkat.",
  "@nitrousOxideMilestone7Description": {"description": "Description for the nitrous oxide recovery milestone at 7 days."},
  "nitrousOxideMilestone14Title": "Dua Minggu – Saraf Memulih",
  "@nitrousOxideMilestone14Title": {"description": "Title for the nitrous oxide recovery milestone at 14 days."},
  "nitrousOxideMilestone14Description": "B12 sangat penting untuk lapisan pelindung pada serabut saraf Anda. Dua minggu kemudian, proses perbaikan tersebut sedang berlangsung secara aktif. Kesemutan atau mati rasa apa pun yang Anda alami seharusnya sudah mereda - sistem saraf Anda sedang memulihkan diri.",
  "@nitrousOxideMilestone14Description": {"description": "Description for the nitrous oxide recovery milestone at 14 days."},
  "nitrousOxideMilestone30Title": "Satu Bulan – Energi Kembali",
  "@nitrousOxideMilestone30Title": {"description": "Title for the nitrous oxide recovery milestone at 30 days."},
  "nitrousOxideMilestone30Description": "B12 memainkan peran penting dalam produksi sel darah merah, yang berarti pengiriman oksigen ke setiap sel di tubuh Anda. Pemulihan dan suplementasi selama satu bulan berarti energi yang jauh lebih baik, pemikiran yang lebih jernih, dan suasana hati yang lebih stabil.",
  "@nitrousOxideMilestone30Description": {"description": "Description for the nitrous oxide recovery milestone at 30 days."},
  "nitrousOxideMilestone90Title": "Tiga Bulan - Pemulihan Neurologis",
  "@nitrousOxideMilestone90Title": {"description": "Title for the nitrous oxide recovery milestone at 90 days."},
  "nitrousOxideMilestone90Description": "Tiga bulan tanpa kerusakan B12 berarti tiga bulan perbaikan saraf. Sistem sarafnya tangguh — kebanyakan orang yang memulai pengobatan segera merasakan pemulihan yang signifikan pada rasa kesemutan, kelemahan, dan kabut otak pada saat ini.",
  "@nitrousOxideMilestone90Description": {"description": "Description for the nitrous oxide recovery milestone at 90 days."},
  "nitrousOxideMilestone365Title": "Satu Tahun – Perlindungan Berlanjut",
  "@nitrousOxideMilestone365Title": {"description": "Title for the nitrous oxide recovery milestone at 365 days."},
  "nitrousOxideMilestone365Description": "Setahun penuh bebas dari dinitrogen oksida. Simpanan B12 Anda dipulihkan, sistem saraf Anda memiliki waktu satu tahun untuk pulih, dan risiko kardiovaskular akibat peningkatan homosistein telah teratasi. Tubuh Anda kembali menjalankan kimianya sendiri.",
  "@nitrousOxideMilestone365Description": {"description": "Description for the nitrous oxide recovery milestone at 365 days."},
