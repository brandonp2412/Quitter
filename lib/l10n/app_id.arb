  "kratomMilestone1Title": "Gejala Putus Zat Dimulai",
  "@kratomMilestone1Title": {"description": "Title for the kratom recovery milestone at 1 day."},
  "kratomMilestone1Description": "Kratom bekerja pada reseptor opioid, sehingga dalam 6–12 jam setelah dosis terakhir Anda dapat mengalami gelisah, cemas, berkeringat, pilek, dan nyeri otot. Ini adalah tanda sistem saraf mulai menyesuaikan diri.",
  "@kratomMilestone1Description": {"description": "Description for the kratom recovery milestone at 1 day."},
  "kratomMilestone3Title": "Puncak Gejala Putus Zat",
  "@kratomMilestone3Title": {"description": "Title for the kratom recovery milestone at 3 days."},
  "kratomMilestone3Description": "Gejala akut biasanya memuncak sekitar hari ke-2–3: nyeri yang lebih kuat, insomnia, gangguan perut, dan suasana hati rendah. Ini biasanya fase tersulit, tetapi bersifat sementara.",
  "@kratomMilestone3Description": {"description": "Description for the kratom recovery milestone at 3 days."},
  "kratomMilestone7Title": "Gejala Akut Mereda",
  "@kratomMilestone7Title": {"description": "Title for the kratom recovery milestone at 7 days."},
  "kratomMilestone7Description": "Setelah satu minggu, gejala fisik terberat — nyeri, gangguan perut, dan berkeringat — sebagian besar sudah mereda. Tidur dan energi masih dalam proses pulih.",
  "@kratomMilestone7Description": {"description": "Description for the kratom recovery milestone at 7 days."},
  "kratomMilestone14Title": "Tidur dan Suasana Hati Membaik",
  "@kratomMilestone14Title": {"description": "Title for the kratom recovery milestone at 14 days."},
  "kratomMilestone14Description": "Setelah dua minggu, tidur biasanya lebih teratur dan suasana hati lebih stabil saat sistem imbalan alami otak mulai menyeimbangkan diri kembali.",
  "@kratomMilestone14Description": {"description": "Description for the kratom recovery milestone at 14 days."},
  "kratomMilestone30Title": "Satu Bulan Tanpa Kratom",
  "@kratomMilestone30Title": {"description": "Title for the kratom recovery milestone at 30 days."},
  "kratomMilestone30Description": "Setelah sebulan, tubuh lebih stabil: tidur, nafsu makan, dan energi terasa jauh lebih baik, sedangkan keinginan kuat untuk menggunakan kratom muncul lebih jarang.",
  "@kratomMilestone30Description": {"description": "Description for the kratom recovery milestone at 30 days."},
  "kratomMilestone90Title": "Fondasi Stabil",
  "@kratomMilestone90Title": {"description": "Title for the kratom recovery milestone at 90 days."},
  "kratomMilestone90Description": "Tiga bulan tanpa kratom memberi sirkuit imbalan dan stres otak lebih banyak waktu untuk mengatur diri kembali. Suasana hati, fokus, dan motivasi biasanya terasa lebih stabil.",
  "@kratomMilestone90Description": {"description": "Description for the kratom recovery milestone at 90 days."},
  "kratomMilestone365Title": "Satu Tahun Tanpa Kratom",
  "@kratomMilestone365Title": {"description": "Title for the kratom recovery milestone at 365 days."},
  "kratomMilestone365Description": "Setahun penuh tanpa kratom. Sistem opioid telah lama mendapat waktu untuk mengatur diri kembali, keinginan menggunakan menjadi jarang, dan kebiasaan itu tidak lagi mengatur hari Anda.",
  "@kratomMilestone365Description": {"description": "Description for the kratom recovery milestone at 365 days."},
  "kratomMilestone730Title": "Dua Tahun: Dasar Kuat",
  "@kratomMilestone730Title": {"description": "Title for the kratom recovery milestone at 730 days."},
  "kratomMilestone730Description": "Dua tahun tanpa kratom adalah rentang perubahan yang panjang dan bertahan. Rutinitas serta pilihan yang menopang perjalanan ini sudah punya waktu untuk menjadi bagian dari keseharian.",
  "@kratomMilestone730Description": {"description": "Description for the kratom recovery milestone at 730 days."},
  "kratomMilestone1095Title": "Tiga Tahun: Momentum Terjaga",
  "@kratomMilestone1095Title": {"description": "Title for the kratom recovery milestone at 1095 days."},
  "kratomMilestone1095Description": "Tiga tahun berarti satu tahun penuh lagi menjalani hidup yang dibangun melampaui kratom. Konsistensi itu adalah momentum yang diperoleh sedikit demi sedikit.",
  "@kratomMilestone1095Description": {"description": "Description for the kratom recovery milestone at 1095 days."},
  "kratomMilestone1460Title": "Empat Tahun: Bebas dan Stabil",
  "@kratomMilestone1460Title": {"description": "Title for the kratom recovery milestone at 1460 days."},
  "kratomMilestone1460Description": "Empat tahun adalah kebebasan yang bertahan, ditopang ribuan keputusan sehari-hari. Hal yang dulu membutuhkan usaha terus-menerus kini dapat semakin jauh dari pusat kehidupan.",
  "@kratomMilestone1460Description": {"description": "Description for the kratom recovery milestone at 1460 days."},
  "kratomMilestone1825Title": "Lima Tahun: Perubahan Bertahan",
  "@kratomMilestone1825Title": {"description": "Title for the kratom recovery milestone at 1825 days."},
  "kratomMilestone1825Description": "Lima tahun adalah hari jadi besar: 1.825 hari mempertahankan arah yang sama. Kehidupan yang dibangun di sekitar pilihan itu adalah pencapaiannya.",
  "@kratomMilestone1825Description": {"description": "Description for the kratom recovery milestone at 1825 days."},
  "gabapentinoidsPageTitle": "Gabapentinoid",
  "@gabapentinoidsPageTitle": {"description": "Title of the gabapentinoids recovery page."},
  "gabapentinoidsHeaderStarted": "Perjalanan Pemulihan Anda",
  "@gabapentinoidsHeaderStarted": {"description": "Heading shown after gabapentinoids tracking starts."},
  "gabapentinoidsHeaderNotStarted": "Manfaat Berhenti Gabapentin / Pregabalin",
