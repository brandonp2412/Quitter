  "ghbPageTitle": "Pemulihan GHB",
  "@ghbPageTitle": {"description": "Title of the ghb recovery page."},
  "ghbHeaderStarted": "Perjalanan Pemulihan Anda",
  "@ghbHeaderStarted": {"description": "Heading shown after ghb tracking starts."},
  "ghbHeaderNotStarted": "Manfaat Berhenti GHB",
  "@ghbHeaderNotStarted": {"description": "Heading shown before ghb tracking starts."},
  "ghbSubtitleStarted": "Lacak kemajuan Anda dan rayakan setiap pencapaian",
  "@ghbSubtitleStarted": {"description": "Subtitle shown after ghb tracking starts."},
  "ghbSubtitleNotStarted": "Lihat apa yang terjadi ketika Anda berhenti",
  "@ghbSubtitleNotStarted": {"description": "Subtitle shown before ghb tracking starts."},
  "ghbInfoBox": "Penarikan GHB adalah keadaan darurat medis — ini menyaingi penghentian alkohol dan benzodiazepin dan dapat menyebabkan delirium dan kejang. Pengguna berat atau sepanjang waktu tidak boleh berhenti tanpa detoksifikasi rawat inap yang diawasi.",
  "@ghbInfoBox": {"description": "Recovery information shown on the ghb page."},
  "addictionGhb": "GHB",
  "@addictionGhb": {"description": "Name of the ghb addiction category."},
  "ghbMilestone1Title": "Carilah Detoksifikasi Medis",
  "@ghbMilestone1Title": {"description": "Title for the ghb recovery milestone at 1 day."},
  "ghbMilestone1Description": "GHB memiliki waktu paruh yang sangat singkat, sehingga penghentian obat dapat dimulai 1–6 jam setelah dosis terakhir dengan gejala kecemasan, tremor, insomnia, dan detak jantung yang cepat. Ini adalah salah satu detoks yang paling berbahaya – dapatkan bantuan medis.",
  "@ghbMilestone1Description": {"description": "Description for the ghb recovery milestone at 1 day."},
  "ghbMilestone3Title": "Jendela Bahaya Puncak",
  "@ghbMilestone3Title": {"description": "Title for the ghb recovery milestone at 3 days."},
  "ghbMilestone3Description": "Gejala memuncak sekitar 48–72 jam dan dapat meningkat menjadi agitasi parah, halusinasi, dan delirium. Fase ini memerlukan pemantauan medis.",
  "@ghbMilestone3Description": {"description": "Description for the ghb recovery milestone at 3 days."},
  "ghbMilestone7Title": "Fase Akut Mulai Berlalu",
  "@ghbMilestone7Title": {"description": "Title for the ghb recovery milestone at 7 days."},
  "ghbMilestone7Description": "Sekitar satu minggu sindrom akut biasanya hilang, meskipun delirium dapat berlangsung lebih lama pada kasus yang parah. Tubuh sudah melewati titik paling berbahaya.",
  "@ghbMilestone7Description": {"description": "Description for the ghb recovery milestone at 7 days."},
  "ghbMilestone14Title": "Melewati Masa Terberat",
  "@ghbMilestone14Title": {"description": "Title for the ghb recovery milestone at 14 days."},
  "ghbMilestone14Description": "Setelah dua minggu, bahkan gejala putus zat yang berat biasanya sudah melewati fase utamanya. Tidur dan kestabilan sistem otonom mulai kembali, meski kecemasan masih dapat bertahan.",
  "@ghbMilestone14Description": {"description": "Description for the ghb recovery milestone at 14 days."},
  "ghbMilestone30Title": "Stabil Satu Bulan",
  "@ghbMilestone30Title": {"description": "Title for the ghb recovery milestone at 30 days."},
  "ghbMilestone30Description": "Dalam sebulan, periode penarikan awal yang berbahaya sudah berlalu. Kecemasan yang berkepanjangan, masalah tidur, dan suasana hati yang buruk terus membaik.",
  "@ghbMilestone30Description": {"description": "Description for the ghb recovery milestone at 30 days."},
  "ghbMilestone90Title": "Gejala yang Berlama-lama Memudar",
  "@ghbMilestone90Title": {"description": "Title for the ghb recovery milestone at 90 days."},
  "ghbMilestone90Description": "Tiga bulan kemudian, gejala kecemasan, tidur, dan suasana hati yang berkepanjangan mereda seiring dengan menetapnya sistem GABA yang menenangkan di otak.",
  "@ghbMilestone90Description": {"description": "Description for the ghb recovery milestone at 90 days."},
  "ghbMilestone180Title": "Enam Bulan Bebas GHB",
  "@ghbMilestone180Title": {"description": "Title for the ghb recovery milestone at 180 days."},
  "ghbMilestone180Description": "Enam bulan bebas GHB. Penarikan diri yang berkepanjangan sebagian besar telah teratasi, dan suasana hati, tidur, serta pemikiran jernih kembali normal.",
  "@ghbMilestone180Description": {"description": "Description for the ghb recovery milestone at 180 days."},
  "ketaminePageTitle": "Pemulihan Ketamin",
  "@ketaminePageTitle": {"description": "Title of the ketamine recovery page."},
  "ketamineHeaderStarted": "Perjalanan Pemulihan Anda",
  "@ketamineHeaderStarted": {"description": "Heading shown after ketamine tracking starts."},
