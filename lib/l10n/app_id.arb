  "relapseMessage1": "Pemulihan tidak linier. Setiap langkah maju penting, termasuk langkah ini.",
  "@relapseMessage1": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage2": "Anda di sini, Anda sedang mencoba, dan itu membutuhkan keberanian yang nyata.",
  "@relapseMessage2": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage3": "Kemunduran tidak menghapus kemajuan Anda. Anda sedang belajar dan berkembang.",
  "@relapseMessage3": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage4": "Setiap restart adalah bukti kekuatan Anda, bukan tanda kelemahan.",
  "@relapseMessage4": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage5": "Besok adalah awal yang baru. Anda punya ini.",
  "@relapseMessage5": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage6": "Nilai Anda tidak ditentukan oleh hasil sempurna. Anda penting.",
  "@relapseMessage6": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage7": "Pemulihan adalah sebuah perjalanan dengan bukit dan lembah. Teruslah berjalan.",
  "@relapseMessage7": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage8": "Anda mempunyai kekuatan untuk memulai sebelumnya, dan Anda memilikinya lagi sekarang.",
  "@relapseMessage8": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage9": "Satu momen tidak menentukan keseluruhan perjalanan Anda ke depan.",
  "@relapseMessage9": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage10": "Berada di sini menunjukkan Anda belum menyerah. Itu sangat kuat.",
  "@relapseMessage10": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage11": "Kemajuan bukanlah tentang kesempurnaan—tetapi tentang ketekunan.",
  "@relapseMessage11": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage12": "Anda membangun ketahanan dalam setiap upaya. Teruslah membangun.",
  "@relapseMessage12": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage13": "Komitmen Anda untuk mencoba lagi sudah merupakan sebuah kemenangan.",
  "@relapseMessage13": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage14": "Penyembuhan tidak terjadi secara instan, namun terjadi seiring dengan setiap pilihan yang Anda buat.",
  "@relapseMessage14": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage15": "Anda tidak memulai dari awal—Anda melanjutkan dengan lebih banyak kebijaksanaan.",
  "@relapseMessage15": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage16": "Setiap ahli pernah menjadi pemula. Setiap profesional pernah menjadi amatir.",
  "@relapseMessage16": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage17": "Pemulihan terjadi setiap hari, terkadang satu jam pada suatu waktu.",
  "@relapseMessage17": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage18": "Anda sedang menulis cerita comeback. Ini hanya satu bab.",
  "@relapseMessage18": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage19": "Fakta bahwa kamu di sini berarti kamu peduli pada dirimu sendiri. Tunggu itu.",
  "@relapseMessage19": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage20": "Langkah kecil ke arah yang benar masih merupakan langkah maju.",
  "@relapseMessage20": {
    "description": "Encouragement message for relapse"
  },
