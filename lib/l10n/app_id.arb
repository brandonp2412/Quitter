  "alcoholMilestone1Title": "Kualitas Tidur Mulai Membaik",
  "@alcoholMilestone1Title": {
    "description": "Alcohol milestone day 1 title"
  },
  "alcoholMilestone1Description": "Siklus tidur REM Anda mulai normal pada hari pertama. Meskipun alkohol mungkin membantu Anda tertidur pada awalnya, alkohol mengganggu siklus tidur nyenyak dan REM sepanjang malam, sehingga menyebabkan tidur terfragmentasi.",
  "@alcoholMilestone1Description": {
    "description": "Alcohol milestone day 1 description"
  },
  "alcoholMilestone3Title": "Hari 3: Putus Alkohol Akut Mencapai Puncak",
  "@alcoholMilestone3Title": {
    "description": "Alcohol milestone day 3 title"
  },
  "alcoholMilestone3Description": "Tiga hari adalah pencapaian besar: gejala putus alkohol sering memuncak sekitar 72 jam. Tremor, insomnia, agitasi, berkeringat, denyut jantung cepat, dan tekanan darah tinggi dapat terasa paling kuat saat ini. Putus alkohol berat masih dapat muncul kemudian, termasuk delirium pada 3–8 hari setelah berhenti.",
  "@alcoholMilestone3Description": {
    "description": "Alcohol milestone day 3 description"
  },
  "alcoholMilestone7Title": "Sistem Kekebalan Tubuh Menguat",
  "@alcoholMilestone7Title": {
    "description": "Alcohol milestone day 7 title"
  },
  "alcoholMilestone7Description": "Sel darah putih Anda memulihkan fungsinya. Bahkan meminum minuman beralkohol dalam jumlah banyak pun dapat mengganggu fungsi kekebalan tubuh hingga 24 jam, dan konsumsi minuman beralkohol secara terus-menerus secara signifikan melemahkan kemampuan tubuh Anda untuk melawan infeksi.",
  "@alcoholMilestone7Description": {
    "description": "Alcohol milestone day 7 description"
  },
  "alcoholMilestone14Title": "Pemulihan Volume Otak Dimulai",
  "@alcoholMilestone14Title": {
    "description": "Alcohol milestone day 14 title"
  },
  "alcoholMilestone14Description": "Volume otak mulai pulih dalam dua minggu pertama. Pemikiran dan ingatan terus meningkat selama beberapa bulan berikutnya.",
  "@alcoholMilestone14Description": {
    "description": "Alcohol milestone day 14 description"
  },
  "alcoholMilestone30Title": "Tekanan Darah Menjadi Normal",
  "@alcoholMilestone30Title": {
    "description": "Alcohol milestone day 30 title"
  },
  "alcoholMilestone30Description": "Sistem kardiovaskular Anda menunjukkan peningkatan yang signifikan. Konsumsi alkohol secara teratur meningkatkan tekanan darah, namun berpantang selama sekitar satu bulan dapat membantu mengembalikan tekanan darah ke tingkat yang lebih sehat.",
  "@alcoholMilestone30Description": {
    "description": "Alcohol milestone day 30 description"
  },
  "alcoholMilestone60Title": "Fungsi Hati Meningkat",
  "@alcoholMilestone60Title": {
    "description": "Alcohol milestone day 60 title"
  },
  "alcoholMilestone60Description": "Hati Anda menunjukkan peningkatan fungsi yang terukur. Organ regeneratif ini dapat pulih secara signifikan dari kerusakan akibat alkohol, dengan enzim hati dan akumulasi lemak menunjukkan perbaikan dalam waktu 2 bulan setelah berhenti mengonsumsi alkohol.",
  "@alcoholMilestone60Description": {
    "description": "Alcohol milestone day 60 description"
  },
  "alcoholMilestone90Title": "Pemikiran dan Ingatan Meningkat Secara Substansial",
  "@alcoholMilestone90Title": {
    "description": "Alcohol milestone day 90 title"
  },
  "alcoholMilestone90Description": "Tiga bulan pertama membawa peningkatan besar dalam memori, konsentrasi, dan pengambilan keputusan, dengan pemulihan terus berlanjut pada bulan-bulan berikutnya.",
  "@alcoholMilestone90Description": {
    "description": "Alcohol milestone day 90 description"
  },
  "alcoholMilestone180Title": "Volume dan Fungsi Otak Melanjutkan Pemulihan",
  "@alcoholMilestone180Title": {
    "description": "Alcohol milestone day 180 title"
  },
  "alcoholMilestone180Description": "Enam bulan sadar memberi otak waktu yang lama untuk pulih. Volume otak dan kemampuan berpikir terus meningkat.",
  "@alcoholMilestone180Description": {
    "description": "Alcohol milestone day 180 description"
  },
  "alcoholMilestone365Title": "Pengurangan Resiko Kanker Mungkin Dimulai",
  "@alcoholMilestone365Title": {
    "description": "Alcohol milestone day 365 title"
  },
  "alcoholMilestone365Description": "Pantang selama satu tahun mungkin mulai mengurangi risiko kanker. Meskipun alkohol jelas meningkatkan risiko beberapa jenis kanker (hati, payudara, kolorektal, esofagus), penelitian mengenai jangka waktu pengurangan risiko masih terus bermunculan dan bervariasi berdasarkan jenis kanker.",
  "@alcoholMilestone365Description": {
    "description": "Alcohol milestone day 365 description"
  },
  "smokingMilestone1Title": "Karbon Monoksida Bersih",
  "@smokingMilestone1Title": {
    "description": "Smoking milestone day 1 title"
  },
  "smokingMilestone1Description": "Darahmu bernafas lagi! Dalam waktu 24 jam, kadar karbon monoksida turun ke normal dan kadar oksigen meningkat. Jantung Anda tidak perlu bekerja lembur lagi untuk memompa darah beracun ke seluruh tubuh Anda.",
  "@smokingMilestone1Description": {
    "description": "Smoking milestone day 1 description"
  },
  "smokingMilestone3Title": "Puncak Penarikan Nikotin",
  "@smokingMilestone3Title": {
    "description": "Smoking milestone day 3 title"
  },
  "smokingMilestone3Description": "Monster nikotin paling marah, tapi Anda memenangkan pertarungan! Semua nikotin telah meninggalkan sistem Anda. Nafsu mengidam yang paling buruk memang terjadi saat ini, namun hal tersebut juga merupakan tiket Anda menuju kebebasan di sisi lain.",
  "@smokingMilestone3Description": {
    "description": "Smoking milestone day 3 description"
  },
  "smokingMilestone7Title": "Rasa & Bau Meningkat Secara Dramatis",
  "@smokingMilestone7Title": {
    "description": "Smoking milestone day 7 title"
  },
  "smokingMilestone7Description": "Makanan akan menjadi petualangan lagi! Merokok merusak indra perasa dan reseptor penciuman. Satu minggu berlalu, dan Anda menemukan kembali rasa yang Anda lupa ada. Bersiaplah untuk apresiasi makanan yang serius!",
  "@smokingMilestone7Description": {
    "description": "Smoking milestone day 7 description"
  },
  "smokingMilestone14Title": "Sirkulasi & Berjalan Meningkat",
  "@smokingMilestone14Title": {
    "description": "Smoking milestone day 14 title"
  },
  "smokingMilestone14Description": "Kakimu berterima kasih pada setiap langkahmu! Sirkulasi darah meningkat secara dramatis, membuat berjalan dan berolahraga menjadi lebih mudah. Tangga itu tidak terlihat menakutkan lagi, bukan?",
  "@smokingMilestone14Description": {
    "description": "Smoking milestone day 14 description"
  },
  "smokingMilestone30Title": "Fungsi Paru-paru Meningkat",
  "@smokingMilestone30Title": {
    "description": "Smoking milestone day 30 title"
  },
  "smokingMilestone30Description": "Paru-parumu mengadakan pesta kembalinya! Silia telah tumbuh kembali dan menyapu aspal dan puing-puing selama bertahun-tahun. Kapasitas paru-paru meningkat secara signifikan, dan batuk perokok sudah menjadi sejarahnya.",
  "@smokingMilestone30Description": {
    "description": "Smoking milestone day 30 description"
  },
  "smokingMilestone90Title": "Risiko Serangan Jantung Turun Secara Signifikan",
  "@smokingMilestone90Title": {
    "description": "Smoking milestone day 90 title"
  },
  "smokingMilestone90Description": "Hatimu mengirimkan surat cinta! Tiga bulan bebas rokok dan risiko kardiovaskular Anda telah menurun secara signifikan. Sistem kardiovaskular Anda pulih lebih cepat dari yang Anda bayangkan.",
  "@smokingMilestone90Description": {
    "description": "Smoking milestone day 90 description"
  },
  "smokingMilestone180Title": "Sistem Kekebalan Tubuh Menguat",
  "@smokingMilestone180Title": {
    "description": "Smoking milestone day 180 title"
  },
  "smokingMilestone180Description": "Sistem kekebalan tubuh Anda baru saja ditingkatkan! Enam bulan tanpa merokok dan sel darah putih Anda kembali ke kekuatan penuhnya, melawan infeksi seperti layaknya seorang juara sejak lahir.",
  "@smokingMilestone180Description": {
    "description": "Smoking milestone day 180 description"
