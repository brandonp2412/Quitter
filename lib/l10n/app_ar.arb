  "relapseMessage1": "التعافي ليس خطيًا. كل خطوة إلى الأمام مهمة، بما في ذلك هذه الخطوة.",
  "@relapseMessage1": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage2": "أنت هنا، أنت تحاول، وهذا يتطلب شجاعة حقيقية.",
  "@relapseMessage2": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage3": "النكسات لا تمحو تقدمك. أنت تتعلم وتنمو.",
  "@relapseMessage3": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage4": "كل إعادة تشغيل هي دليل على قوتك، وليست علامة ضعف.",
  "@relapseMessage4": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage5": "غدا بداية جديدة. لقد حصلت على هذا.",
  "@relapseMessage5": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage6": "لا يتم تحديد قيمتك من خلال الخطوط المثالية. أنت مهم.",
  "@relapseMessage6": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage7": "التعافي هو رحلة بين التلال والوديان. استمر في المشي.",
  "@relapseMessage7": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage8": "لقد كانت لديك القوة للبدء من قبل، وتملكها مرة أخرى الآن.",
  "@relapseMessage8": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage9": "لحظة واحدة لا تحدد رحلتك بأكملها إلى الأمام.",
  "@relapseMessage9": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage10": "وجودك هنا يظهر أنك لم تستسلم. هذا قوي.",
  "@relapseMessage10": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage11": "التقدم لا يتعلق بالكمال، بل يتعلق بالمثابرة.",
  "@relapseMessage11": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage12": "أنت تبني المرونة مع كل محاولة. استمر في البناء.",
  "@relapseMessage12": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage13": "إن التزامك بالمحاولة مرة أخرى هو بالفعل انتصار.",
  "@relapseMessage13": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage14": "الشفاء ليس فوريًا، ولكنه يحدث مع كل خيار تقوم به.",
  "@relapseMessage14": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage15": "أنت لا تبدأ من جديد، بل تستمر بمزيد من الحكمة.",
  "@relapseMessage15": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage16": "كان كل خبير مبتدئًا في يوم من الأيام. كل محترف كان ذات يوم أحد الهواة.",
  "@relapseMessage16": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage17": "يحدث التعافي يومًا بعد يوم، وأحيانًا ساعة واحدة في كل مرة.",
  "@relapseMessage17": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage18": "أنت تكتب قصة العودة. وهذا مجرد فصل واحد.",
  "@relapseMessage18": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage19": "حقيقة وجودك هنا تعني أنك تهتم بنفسك. التمسك بذلك.",
  "@relapseMessage19": {
    "description": "Encouragement message for relapse"
  },
  "relapseMessage20": "الخطوات الصغيرة في الاتجاه الصحيح لا تزال خطوات للأمام.",
