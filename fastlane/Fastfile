# This file contains the fastlane lanes.
# More information about fastlane can be found here:
# https://docs.fastlane.tools

default_platform(:android)

platform :android do
  private_lane :sync_localized_changelogs do
    sh("python3", File.expand_path("../scripts/sync_play_changelogs.py", __dir__))
  end

  desc "Deploy to Google Play"
  lane :deploy do |options|
    metadata(
      track: options[:track] || "production",
      skip_changelogs: true
    )
    supply(
      aab: options[:aab],
      json_key: options[:json_key],
      package_name: "com.quitter.app",
      track: options[:track] || "production",
      skip_upload_changelogs: false,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload the complete Google Play store listing without a binary release"
  lane :metadata do |options|
    sync_localized_changelogs
    skip_changelogs = options[:skip_changelogs].to_s == "true"
    supply(
      json_key: options[:json_key],
      package_name: "com.quitter.app",
      track: options[:track] || "production",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: skip_changelogs,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end
end
